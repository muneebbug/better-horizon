{%- doc -%}
  Form Radio Group styles consolidated into a modular snippet.

  @example
  {% render 'form-radio-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .custom-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs, 6px);
    position: relative;
    box-sizing: border-box;
    width: 100%;
  }

  .custom-form__field--width-100 { width: 100%; flex: 0 0 100%; }
  .custom-form__field--width-75 { width: 100%; flex: 0 0 100%; }
  .custom-form__field--width-50 { width: 100%; flex: 0 0 100%; }
  .custom-form__field--width-33 { width: 100%; flex: 0 0 100%; }
  .custom-form__field--width-25 { width: 100%; flex: 0 0 100%; }
  .custom-form__field--width-auto { width: auto; flex: 0 1 auto; }

  @media screen and (min-width: 750px) {
    .custom-form__field--width-75 {
      width: calc(75% - (var(--form-gap, var(--gap, 16px)) * 1 / 4));
      flex: 0 0 calc(75% - (var(--form-gap, var(--gap, 16px)) * 1 / 4));
    }
    .custom-form__field--width-50 {
      width: calc(50% - (var(--form-gap, var(--gap, 16px)) / 2));
      flex: 0 0 calc(50% - (var(--form-gap, var(--gap, 16px)) / 2));
    }
    .custom-form__field--width-33 {
      width: calc(33.333% - (var(--form-gap, var(--gap, 16px)) * 2 / 3));
      flex: 0 0 calc(33.333% - (var(--form-gap, var(--gap, 16px)) * 2 / 3));
    }
    .custom-form__field--width-25 {
      width: calc(25% - (var(--form-gap, var(--gap, 16px)) * 3 / 4));
      flex: 0 0 calc(25% - (var(--form-gap, var(--gap, 16px)) * 3 / 4));
    }
  }

  .custom-form__help-text {
    font-size: calc(var(--font-paragraph--size, 14px) * 0.85);
    color: var(--form-help-color, rgb(var(--color-foreground-rgb) / 0.65));
    line-height: 1.4;
  }

  .custom-form__required-mark {
    color: var(--color-error, #dc2626);
    font-weight: 700;
  }

  .custom-form__radio-group {
    border: none;
    padding: 0;
    margin: 0;
    width: 100%;
  }

  .custom-form__radio-legend {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: var(--form-label-size, var(--font-paragraph--size, 14px));
    font-weight: var(--form-label-weight, 500);
    color: var(--form-label-color, var(--color-foreground));
    margin-bottom: var(--gap-xs, 8px);
    padding: 0;
  }

  .custom-form__radio-options {
    display: flex;
    gap: 8px;
    width: 100%;
  }

  .custom-form__radio-options--column {
    flex-direction: column;
  }

  .custom-form__radio-options--row {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .custom-form__radio-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    font-size: var(--form-input-font-size, 14px);
    color: var(--color-foreground);
    background-color: var(--color-input-background, var(--color-background));
    border: var(--style-border-width-inputs, var(--style-border-width, 1px)) solid var(--color-input-border, rgb(var(--color-foreground-rgb) / 0.2));
    border-radius: var(--style-border-radius-inputs, 6px);
    cursor: pointer;
    box-sizing: border-box;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
    min-height: 38px;
  }

  .custom-form__radio-label:hover {
    border-color: var(--color-input-hover-border, rgb(var(--color-foreground-rgb) / 0.4));
  }

  .custom-form__radio-label input[type="radio"] {
    accent-color: var(--color-foreground);
    margin: 0;
    cursor: pointer;
    width: 16px;
    height: 16px;
  }

  .custom-form__radio-label:has(input[type="radio"]:checked) {
    background-color: var(--form-radio-active-bg, rgb(var(--color-foreground-rgb) / 0.08));
    color: var(--form-radio-active-text, var(--color-foreground));
    border-color: var(--form-radio-active-border, var(--color-foreground));
    font-weight: 500;
  }

  .custom-form__radio-label:has(input[type="radio"]:focus-visible) {
    outline: var(--focus-outline-width, 2px) solid var(--color-foreground);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .custom-form__radio-label {
      transition: none;
    }
  }
{% endstylesheet %}
