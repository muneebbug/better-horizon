{% doc %}
  Wishlist Drawer Snippet
  Renders an accessible slide-out drawer hosting saved wishlist items.
  Strictly conforms to Horizon's drawer design system, typography, borders, and button styles.
{% enddoc %}

<script
  src="{{ 'wishlist.js' | asset_url }}"
  defer
  type="module"
></script>

<theme-drawer id="wishlist-drawer" data-skip-node-update>
  <dialog
    ref="panel"
    class="theme-drawer__dialog color-custom-drawer"
    aria-labelledby="wishlist-drawer-heading"
  >
    <wishlist-drawer class="wishlist-drawer-component">
      <div class="wishlist-drawer__inner wishlist-drawer--empty" data-hydration-key="wishlist-drawer-inner">
        
        {%- comment -%} Non-Empty Header {%- endcomment -%}
        <div class="theme-drawer__header wishlist-drawer__header-filled">
          <h2 class="theme-drawer__title h4" id="wishlist-drawer-heading">
            Wishlist
            <wishlist-count class="theme-drawer__badge" aria-hidden="true"></wishlist-count>
          </h2>

          <button
            class="theme-drawer__close-button"
            on:click="#wishlist-drawer/close"
            type="button"
            aria-label="{{ 'actions.close' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>

        {%- comment -%} Empty State Header {%- endcomment -%}
        <div class="theme-drawer__header wishlist-drawer__header-empty">
          <button
            on:click="#wishlist-drawer/close"
            class="theme-drawer__close-button wishlist-drawer__close-button--empty"
            type="button"
            aria-label="{{ 'actions.close' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>

        <div class="wishlist-drawer__content">
          {%- comment -%} Empty State Content {%- endcomment -%}
          <div data-wishlist-empty class="wishlist-drawer__empty">
            <h2 class="theme-drawer__title h4">
              Your wishlist is empty
            </h2>
            <p class="wishlist-drawer__empty-subtext">
              Save items you love to revisit them later.
            </p>
            <button
              type="button"
              class="button button-secondary wishlist-drawer__empty-button"
              on:click="#wishlist-drawer/close"
            >
              <span class="button-text">{{ 'actions.continue_shopping' | t }}</span>
            </button>
          </div>

          {%- comment -%} Items List {%- endcomment -%}
          <div data-wishlist-items class="wishlist-drawer__items"></div>
        </div>

      </div>
    </wishlist-drawer>
  </dialog>
</theme-drawer>

{% stylesheet %}
  .wishlist-drawer-component {
    --wishlist-drawer-padding: var(--theme-drawer-padding);
    display: contents;
  }

  .wishlist-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  /* Header switching between empty and filled */
  .wishlist-drawer--empty .wishlist-drawer__header-filled {
    display: none;
  }

  .wishlist-drawer--empty .wishlist-drawer__header-empty {
    display: flex;
  }

  .wishlist-drawer:not(.wishlist-drawer--empty) .wishlist-drawer__header-empty,
  .wishlist-drawer__inner:not(.wishlist-drawer--empty) .wishlist-drawer__header-empty {
    display: none;
  }

  .wishlist-drawer:not(.wishlist-drawer--empty) .wishlist-drawer__header-filled,
  .wishlist-drawer__inner:not(.wishlist-drawer--empty) .wishlist-drawer__header-filled {
    display: flex;
  }

  .wishlist-drawer__close-button--empty {
    margin-inline-start: auto;
  }

  /* Content area */
  .wishlist-drawer__content {
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: var(--color-background);
    flex-grow: 1;
    overflow-y: auto;
  }

  /* Empty state */
  .wishlist-drawer--empty .wishlist-drawer__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    flex-grow: 1;
    padding: var(--padding-2xl, 32px) var(--wishlist-drawer-padding);
  }

  .wishlist-drawer__inner:not(.wishlist-drawer--empty) .wishlist-drawer__empty {
    display: none !important;
  }

  .wishlist-drawer__empty-subtext {
    margin-block-start: var(--margin-xs, 8px);
    margin-block-end: var(--margin-xl, 24px);
    font-size: var(--font-body--size, 14px);
    color: var(--color-foreground-subdued, rgb(var(--color-foreground-rgb) / 0.7));
  }

  .wishlist-drawer__empty-button {
    min-height: 44px;
    padding: 0 var(--padding-xl, 24px);
    border-radius: var(--style-border-radius-buttons-secondary, 9999px);
  }

  /* Wishlist Item Rows (matches cart items table row) */
  .wishlist-drawer__items {
    display: flex;
    flex-direction: column;
    padding-inline: var(--wishlist-drawer-padding);
    padding-block-start: var(--padding-md, 16px);
    overflow-y: auto;
  }

  .wishlist-drawer--empty .wishlist-drawer__items {
    display: none !important;
  }

  .wishlist-item {
    display: grid;
    grid-template-columns: 72px 1fr;
    grid-template-areas: "media details";
    gap: var(--gap-md, 16px);
    padding-bottom: var(--gap-xl, 20px);
    border-bottom: var(--style-border-width, 1px) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25, 0.15));
    margin-bottom: var(--gap-xl, 20px);
    align-items: start;
  }

  .wishlist-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
  }

  .wishlist-item .wishlist-item__media-container {
    width: 72px;
    height: 72px;
    border-radius: var(--style-border-radius-inputs, 6px);
    overflow: hidden;
    display: flex;
    aspect-ratio: 1;
    position: relative;
  }

  .wishlist-item .wishlist-item__media-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--style-border-radius-inputs, 6px);
  }

  .wishlist-item__details {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs, 8px);
    width: 100%;
  }

  .wishlist-item__title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--gap-xs, 8px);
  }

  .wishlist-item__title {
    font-size: var(--font-body--size, 14px);
    font-weight: 600;
    color: var(--color-foreground);
    text-decoration: none;
    line-height: 1.3;
  }

  .wishlist-item__title:hover {
    text-decoration: underline;
  }

  .wishlist-item__price {
    font-size: var(--font-body--size, 14px);
    color: var(--color-foreground);
    white-space: nowrap;
    font-weight: 500;
  }

  .wishlist-item__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-sm, 12px);
    margin-top: 4px;
  }

  .wishlist-item__add-to-cart {
    height: auto;
    min-height: 36px;
    padding: 6px 16px;
    font-size: var(--font-size--xs, 12px);
    text-transform: var(--button-text-case-secondary, none);
    border-radius: var(--style-border-radius-buttons-secondary, 9999px);
    cursor: pointer;
  }

  .wishlist-item__add-to-cart:disabled {
    opacity: 0.7;
    cursor: default;
  }

  .wishlist-item__remove-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    color: var(--color-foreground);
    width: var(--minimum-touch-target, 44px);
    height: var(--minimum-touch-target, 44px);
  }

  .wishlist-item__remove-btn:hover .remove-icon-top {
    transform: rotate(-15deg);
    transform-origin: left bottom;
    transition: transform 0.2s ease;
  }
{% endstylesheet %}
