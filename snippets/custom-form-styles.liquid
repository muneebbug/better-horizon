{%- doc -%}
  Custom Form Container Stylesheet.
  Contains layout, card presets, grid width utilities, and status alerts for the form container block.

  @example
  {% render 'custom-form-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .custom-form {
    display: block;
    width: 100%;
    box-sizing: border-box;
  }

  /* Card Container Styles */
  .custom-form--card-default {
    background-color: var(--form-card-bg, rgb(var(--color-foreground-rgb) / var(--opacity-3, 0.03)));
    border: var(--form-card-border-width, var(--style-border-width, 1px)) solid var(--form-card-border, rgb(var(--color-foreground-rgb) / var(--opacity-10-25, 0.12)));
    border-radius: var(--form-card-border-radius, var(--style-border-radius-inputs, 8px));
    padding: var(--form-card-padding, 24px);
  }

  .custom-form--card-minimal {
    background-color: transparent;
    border: none;
    padding: 0;
  }

  .custom-form--card-outline {
    background-color: transparent;
    border: var(--form-card-border-width, var(--style-border-width, 1px)) solid var(--form-card-border, rgb(var(--color-foreground-rgb) / var(--opacity-10-25, 0.15)));
    border-radius: var(--form-card-border-radius, var(--style-border-radius-inputs, 8px));
    padding: var(--form-card-padding, 24px);
  }

  .custom-form--card-custom {
    background-color: var(--form-card-bg, transparent);
    border: var(--form-card-border-width, 1px) solid var(--form-card-border, transparent);
    border-radius: var(--form-card-border-radius, 8px);
    padding: var(--form-card-padding, 24px);
  }

  .custom-form__form {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    gap: var(--form-gap, var(--gap, var(--gap-md, 16px)));
  }

  .custom-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs, 6px);
    position: relative;
    box-sizing: border-box;
    width: 100%;
  }

  /* Width Utility Classes */
  .custom-form__field--width-100 {
    width: 100%;
    flex: 0 0 100%;
  }

  .custom-form__field--width-75 {
    width: 100%;
    flex: 0 0 100%;
  }

  .custom-form__field--width-50 {
    width: 100%;
    flex: 0 0 100%;
  }

  .custom-form__field--width-33 {
    width: 100%;
    flex: 0 0 100%;
  }

  .custom-form__field--width-25 {
    width: 100%;
    flex: 0 0 100%;
  }

  .custom-form__field--width-auto {
    width: auto;
    flex: 0 1 auto;
  }

  @media screen and (min-width: 750px) {
    .custom-form__field--width-75 {
      width: calc(75% - (var(--form-gap, var(--gap, 16px)) * 1 / 4));
      flex: 0 0 calc(75% - (var(--form-gap, var(--gap, 16px)) * 1 / 4));
    }

    .custom-form__field--width-50 {
      width: calc(50% - (var(--form-gap, var(--gap, 16px)) / 2));
      flex: 0 0 calc(50% - (var(--form-gap, var(--gap, 16px)) / 2));
    }

    .custom-form__field--width-33 {
      width: calc(33.333% - (var(--form-gap, var(--gap, 16px)) * 2 / 3));
      flex: 0 0 calc(33.333% - (var(--form-gap, var(--gap, 16px)) * 2 / 3));
    }

    .custom-form__field--width-25 {
      width: calc(25% - (var(--form-gap, var(--gap, 16px)) * 3 / 4));
      flex: 0 0 calc(25% - (var(--form-gap, var(--gap, 16px)) * 3 / 4));
    }
  }

  .custom-form__label {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: var(--form-label-size, var(--font-paragraph--size, 14px));
    font-weight: var(--form-label-weight, 500);
    color: var(--form-label-color, var(--color-foreground));
    line-height: 1.4;
  }

  .custom-form__required-mark {
    color: var(--color-error, #dc2626);
    font-weight: 700;
  }

  .custom-form__help-text {
    font-size: calc(var(--font-paragraph--size, 14px) * 0.85);
    color: var(--form-help-color, rgb(var(--color-foreground-rgb) / 0.65));
    line-height: 1.4;
  }

  /* Status Alerts */
  .custom-form__alert {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
    flex: 0 0 100%;
    padding: 14px 18px;
    border-radius: var(--style-border-radius-inputs, 8px);
    box-sizing: border-box;
    font-size: var(--form-input-font-size, 14px);
    line-height: 1.5;
    margin-bottom: var(--gap-xs, 8px);
  }

  .custom-form__alert-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .custom-form__alert-icon svg {
    width: 20px;
    height: 20px;
  }

  .custom-form__alert-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    min-width: 0;
  }

  .custom-form__alert-title {
    font-weight: 500;
    line-height: 1.4;
  }

  .custom-form__alert-list {
    margin: 4px 0 0;
    padding-left: 18px;
    font-size: calc(var(--form-input-font-size, 14px) * 0.9);
  }

  .custom-form__alert--success {
    background-color: var(--form-success-bg, rgb(16 185 129 / 0.08));
    color: var(--form-success-text, #065f46);
    border: 1px solid var(--form-success-border, rgb(16 185 129 / 0.25));
  }

  .custom-form__alert--error {
    background-color: var(--form-error-bg, rgb(239 68 68 / 0.08));
    color: var(--form-error-text, #991b1b);
    border: 1px solid var(--form-error-border, rgb(239 68 68 / 0.25));
  }
{% endstylesheet %}
