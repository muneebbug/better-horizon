{%- doc -%}
  Form Submit Button styles consolidated into a modular snippet.

  @example
  {% render 'form-submit-button-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .custom-form__submit-wrapper {
    display: flex;
    width: 100%;
    margin-top: var(--gap-xs, 8px);
  }

  .custom-form__submit-wrapper--left { justify-content: flex-start; }
  .custom-form__submit-wrapper--center { justify-content: center; }
  .custom-form__submit-wrapper--right { justify-content: flex-end; }
  .custom-form__submit-wrapper--full-width { width: 100%; }

  .custom-form__submit-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-family: inherit;
    font-weight: 500;
    text-align: center;
    box-sizing: border-box;
    transition: opacity 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }

  .custom-form__submit-button--full-width {
    width: 100%;
  }

  .custom-form__submit-button--small {
    padding: 8px 16px;
    font-size: calc(var(--font-paragraph--size, 14px) * 0.85);
    min-height: 36px;
  }

  .custom-form__submit-button--medium {
    padding: 12px 24px;
    font-size: var(--font-paragraph--size, 14px);
    min-height: 44px;
  }

  .custom-form__submit-button--large {
    padding: 16px 32px;
    font-size: calc(var(--font-paragraph--size, 14px) * 1.1);
    min-height: 52px;
  }

  .custom-form__submit-button--custom {
    background-color: var(--form-btn-bg, var(--color-foreground));
    color: var(--form-btn-text, var(--color-background));
    border: var(--form-btn-border-width, 1px) solid var(--form-btn-border, var(--color-foreground));
    border-radius: var(--form-btn-radius, var(--style-border-radius-inputs, 6px));
  }

  .custom-form__submit-button--custom:hover {
    opacity: 0.9;
  }

  .custom-form__submit-button:focus-visible {
    outline: var(--focus-outline-width, 2px) solid var(--color-foreground);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .custom-form__submit-button {
      transition: none;
    }
  }
{% endstylesheet %}
