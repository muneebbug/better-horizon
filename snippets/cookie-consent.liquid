{% doc %}
  Cookie Consent Banner Snippet
  Renders privacy consent controls integrated with Shopify Customer Privacy API and GA4 Consent Mode v2.
{% enddoc %}

<script
  src="{{ 'cookie-consent.js' | asset_url }}"
  defer
  type="module"
></script>

<cookie-consent-banner id="CookieConsent">
  <div
    data-consent-banner
    class="cookie-consent-banner"
    hidden
    role="region"
    aria-label="Cookie and Privacy Consent"
  >
    <div class="cookie-consent-banner__inner">
      <div class="cookie-consent-banner__content">
        <p class="cookie-consent-banner__text">
          We use cookies and similar technologies to enhance your browsing experience, serve personalized content, and analyze our traffic. You can choose to accept all cookies, decline non-essential cookies, or manage your preferences.
        </p>
      </div>

      <div class="cookie-consent-banner__actions">
        <button
          type="button"
          data-consent-accept-all
          class="button button-primary cookie-consent-btn"
        >
          Accept All
        </button>
        <button
          type="button"
          data-consent-decline-all
          class="button button-secondary cookie-consent-btn"
        >
          Decline
        </button>
        <button
          type="button"
          data-consent-prefs
          class="cookie-consent-btn--text"
        >
          Preferences
        </button>
      </div>
    </div>
  </div>

  <dialog
    data-consent-modal
    class="cookie-consent-modal"
    aria-label="Cookie Preferences"
  >
    <div class="cookie-consent-modal__inner">
      <div class="cookie-consent-modal__header">
        <h2 class="cookie-consent-modal__title">Cookie & Privacy Preferences</h2>
        <button
          type="button"
          data-consent-close-modal
          class="cookie-consent-modal__close"
          aria-label="Close preferences"
        >
          <span class="svg-wrapper">
            {{ 'icon-close.svg' | inline_asset_content }}
          </span>
        </button>
      </div>

      <div class="cookie-consent-modal__body">
        <div class="cookie-category">
          <div class="cookie-category__header">
            <strong>Strictly Necessary Cookies</strong>
            <span class="cookie-category__badge">Always Active</span>
          </div>
          <p class="cookie-category__desc">Required for basic site functionality, security, checkout, and shopping cart.</p>
        </div>

        <div class="cookie-category">
          <div class="cookie-category__header">
            <label for="ConsentAnalytics"><strong>Analytics & Performance</strong></label>
            <input type="checkbox" id="ConsentAnalytics" data-consent-analytics checked class="cookie-toggle">
          </div>
          <p class="cookie-category__desc">Help us measure site traffic and improve performance and user experience.</p>
        </div>

        <div class="cookie-category">
          <div class="cookie-category__header">
            <label for="ConsentMarketing"><strong>Marketing & Advertising</strong></label>
            <input type="checkbox" id="ConsentMarketing" data-consent-marketing checked class="cookie-toggle">
          </div>
          <p class="cookie-category__desc">Used to provide relevant promotions and personalized recommendations.</p>
        </div>
      </div>

      <div class="cookie-consent-modal__footer">
        <button
          type="button"
          data-consent-save-prefs
          class="button button-primary"
        >
          Save Preferences
        </button>
      </div>
    </div>
  </dialog>
</cookie-consent-banner>

{% stylesheet %}
  .cookie-consent-banner {
    position: fixed;
    bottom: 20px;
    left: 20px;
    right: 20px;
    max-width: 600px;
    z-index: 1000;
    background: var(--color-background);
    color: var(--color-foreground);
    padding: var(--padding-md, 20px);
    border-radius: var(--style-border-radius-inputs, 10px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    border: var(--style-border-width, 1px) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25, 0.15));
    transition: transform var(--animation-speed, 0.3s) ease, opacity var(--animation-speed, 0.3s) ease;
  }

  .cookie-consent-banner.is-visible {
    display: block !important;
  }

  .cookie-consent-banner__text {
    margin: 0 0 16px 0;
    font-size: var(--font-body--size, 13px);
    line-height: 1.5;
    color: var(--color-foreground-subdued, rgb(var(--color-foreground-rgb) / 0.7));
  }

  .cookie-consent-banner__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .cookie-consent-btn {
    padding: 8px 16px;
    min-height: 38px;
    font-size: var(--font-body--size, 13px);
    border-radius: var(--style-border-radius-buttons-primary, 9999px);
  }

  .cookie-consent-btn--text {
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: var(--font-body--size, 13px);
    text-decoration: underline;
    color: var(--color-foreground);
    padding: 6px;
    min-height: 38px;
  }

  .cookie-consent-modal {
    border: var(--style-border-width, 1px) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25, 0.15));
    border-radius: var(--style-border-radius-inputs, 10px);
    padding: 0;
    width: min(520px, 92vw);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .cookie-consent-modal::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
  }

  .cookie-consent-modal__inner {
    padding: var(--padding-lg, 24px);
  }

  .cookie-consent-modal__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--margin-md, 16px);
  }

  .cookie-consent-modal__title {
    margin: 0;
    font-size: var(--font-body--size, 18px);
    font-weight: 600;
  }

  .cookie-consent-modal__close {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-foreground);
  }

  .cookie-category {
    padding: 12px 0;
    border-bottom: var(--style-border-width, 1px) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25, 0.15));
  }

  .cookie-category:last-child {
    border-bottom: none;
  }

  .cookie-category__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }

  .cookie-category__badge {
    font-size: var(--font-size--2xs, 11px);
    background: rgb(var(--color-foreground-rgb) / 0.08);
    color: var(--color-foreground);
    padding: 2px 8px;
    border-radius: 12px;
    font-weight: 500;
  }

  .cookie-category__desc {
    margin: 0;
    font-size: var(--font-size--xs, 12px);
    color: var(--color-foreground-subdued, rgb(var(--color-foreground-rgb) / 0.7));
  }

  .cookie-toggle {
    width: 20px;
    height: 20px;
    cursor: pointer;
    accent-color: var(--color-foreground);
  }

  .cookie-consent-modal__footer {
    margin-top: var(--margin-md, 20px);
    display: flex;
    justify-content: flex-end;
  }
{% endstylesheet %}
