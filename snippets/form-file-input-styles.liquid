{%- doc -%}
  Form File Input & Media Preview styles consolidated into a modular snippet.

  @example
  {% render 'form-file-input-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .custom-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs, 6px);
    position: relative;
    box-sizing: border-box;
    width: 100%;
  }

  .custom-form__field--width-100 { width: 100%; flex: 0 0 100%; }
  .custom-form__field--width-75 { width: 100%; flex: 0 0 100%; }
  .custom-form__field--width-50 { width: 100%; flex: 0 0 100%; }
  .custom-form__field--width-33 { width: 100%; flex: 0 0 100%; }
  .custom-form__field--width-25 { width: 100%; flex: 0 0 100%; }
  .custom-form__field--width-auto { width: auto; flex: 0 1 auto; }

  @media screen and (min-width: 750px) {
    .custom-form__field--width-75 {
      width: calc(75% - (var(--form-gap, var(--gap, 16px)) * 1 / 4));
      flex: 0 0 calc(75% - (var(--form-gap, var(--gap, 16px)) * 1 / 4));
    }
    .custom-form__field--width-50 {
      width: calc(50% - (var(--form-gap, var(--gap, 16px)) / 2));
      flex: 0 0 calc(50% - (var(--form-gap, var(--gap, 16px)) / 2));
    }
    .custom-form__field--width-33 {
      width: calc(33.333% - (var(--form-gap, var(--gap, 16px)) * 2 / 3));
      flex: 0 0 calc(33.333% - (var(--form-gap, var(--gap, 16px)) * 2 / 3));
    }
    .custom-form__field--width-25 {
      width: calc(25% - (var(--form-gap, var(--gap, 16px)) * 3 / 4));
      flex: 0 0 calc(25% - (var(--form-gap, var(--gap, 16px)) * 3 / 4));
    }
  }

  .custom-form__label {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: var(--form-label-size, var(--font-paragraph--size, 14px));
    font-weight: var(--form-label-weight, 500);
    color: var(--form-label-color, var(--color-foreground));
    line-height: 1.4;
  }

  .custom-form__required-mark {
    color: var(--color-error, #dc2626);
    font-weight: 700;
  }

  .custom-form__help-text {
    font-size: calc(var(--font-paragraph--size, 14px) * 0.85);
    color: var(--form-help-color, rgb(var(--color-foreground-rgb) / 0.65));
    line-height: 1.4;
  }

  /* File Upload Component */
  .custom-form__file-component {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm, 12px);
    width: 100%;
    box-sizing: border-box;
  }

  .custom-form__file-component [hidden],
  .custom-form__file-dropzone[hidden],
  .custom-form__file-stage[hidden],
  .custom-form__file-list[hidden],
  .custom-form__file-error[hidden] {
    display: none !important;
  }

  .custom-form__file-dropzone {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--padding-xl, 28px) var(--padding-lg, 20px);
    border: 2px dashed var(--form-file-border, rgb(var(--color-foreground-rgb) / 0.25));
    border-radius: var(--form-file-radius, var(--style-border-radius-inputs, 8px));
    background-color: var(--form-file-bg, var(--color-background));
    color: var(--form-file-text, var(--color-foreground));
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
    outline: none;
    box-sizing: border-box;
    width: 100%;
  }

  .custom-form__file-dropzone:hover,
  .custom-form__file-dropzone--dragover {
    border-color: var(--color-foreground);
    background-color: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .custom-form__file-dropzone:focus-visible {
    outline: var(--focus-outline-width, 2px) solid var(--color-foreground);
    outline-offset: 2px;
  }

  .custom-form__file-native-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 1;
  }

  .custom-form__file-dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    pointer-events: none;
  }

  .custom-form__file-dropzone-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: rgb(var(--color-foreground-rgb) / 0.06);
    color: var(--color-foreground);
    margin-bottom: 4px;
    transition: background-color var(--animation-duration, 0.2s) ease, transform var(--animation-duration, 0.2s) ease;
  }

  .custom-form__file-dropzone-icon .svg-wrapper,
  .custom-form__file-dropzone-icon svg {
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-form__file-dropzone:hover .custom-form__file-dropzone-icon,
  .custom-form__file-dropzone--dragover .custom-form__file-dropzone-icon {
    background-color: rgb(var(--color-foreground-rgb) / 0.1);
    transform: translateY(-2px);
  }

  .custom-form__file-dropzone-title {
    font-size: var(--font-paragraph--size, 14px);
    font-weight: 500;
    color: var(--color-foreground);
  }

  .custom-form__file-dropzone-hint {
    font-size: calc(var(--font-paragraph--size, 14px) * 0.85);
    color: var(--form-file-hint, rgb(var(--color-foreground-rgb) / 0.6));
  }

  /* File Error */
  .custom-form__file-error {
    font-size: calc(var(--font-paragraph--size, 14px) * 0.9);
    color: var(--color-error, #dc2626);
    background-color: rgb(220 38 38 / 0.08);
    border: 1px solid rgb(220 38 38 / 0.2);
    border-radius: var(--style-border-radius-inputs, 6px);
    padding: 8px 12px;
  }

  /* Preview Stage */
  .custom-form__file-stage {
    width: 100%;
    box-sizing: border-box;
  }

  .custom-form__file-stage-wrapper {
    position: relative;
    width: 100%;
    border-radius: var(--form-file-stage-radius, var(--form-file-radius, var(--style-border-radius-inputs, 8px)));
    overflow: hidden;
    background-color: var(--form-file-stage-bg, var(--color-background));
    border: var(--form-file-stage-border-width, 1px) solid var(--form-file-stage-border, rgb(var(--color-foreground-rgb) / 0.12));
    box-sizing: border-box;
  }

  .custom-form__file-stage-img {
    display: block;
    width: 100%;
    max-height: 280px;
    object-fit: contain;
    background-color: rgb(var(--color-foreground-rgb) / 0.03);
  }

  .custom-form__file-stage-video {
    display: block;
    width: 100%;
    max-height: 280px;
    background-color: #000;
  }

  .custom-form__file-stage-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 14px;
    background-color: var(--form-file-stage-bg, var(--color-background));
    font-size: calc(var(--font-paragraph--size, 14px) * 0.85);
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }

  .custom-form__file-stage-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow: hidden;
  }

  .custom-form__file-stage-title {
    font-weight: 500;
    color: var(--form-file-stage-text, var(--color-foreground));
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .custom-form__file-stage-size {
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  /* File Lists */
  .custom-form__file-list {
    width: 100%;
    box-sizing: border-box;
  }

  /* List Layout */
  .custom-form__file-list--list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .custom-form__file-card--list {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 12px;
    background-color: var(--form-file-card-bg, var(--color-input-background, var(--color-background)));
    border: var(--form-file-card-border-width, 1px) solid var(--form-file-card-border, rgb(var(--color-foreground-rgb) / 0.12));
    border-radius: var(--form-file-card-radius, var(--form-file-radius, var(--style-border-radius-inputs, 6px)));
    box-sizing: border-box;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .custom-form__file-card--list:hover {
    border-color: var(--color-input-hover-border, rgb(var(--color-foreground-rgb) / 0.35));
  }

  .custom-form__file-card--active {
    border-color: var(--form-file-active-highlight, var(--color-foreground)) !important;
    box-shadow: 0 0 0 1px var(--form-file-active-highlight, var(--color-foreground));
  }

  .custom-form__file-thumb-box {
    position: relative;
    width: var(--thumb-size, 48px);
    height: var(--thumb-size, 48px);
    border-radius: calc(var(--form-file-card-radius, var(--form-file-radius, var(--style-border-radius-inputs, 6px))) * 0.8);
    overflow: hidden;
    background-color: rgb(var(--color-foreground-rgb) / 0.05);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-form__file-thumb-img,
  .custom-form__file-thumb-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .custom-form__file-badge-media {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.35);
    color: #fff;
    font-size: 11px;
    pointer-events: none;
  }

  .custom-form__file-icon-doc {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .custom-form__file-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .custom-form__file-name {
    font-size: calc(var(--font-paragraph--size, 14px) * 0.9);
    font-weight: 500;
    color: var(--form-file-card-text, var(--color-foreground));
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .custom-form__file-meta {
    font-size: calc(var(--font-paragraph--size, 14px) * 0.78);
    color: var(--form-file-card-meta, rgb(var(--color-foreground-rgb) / 0.6));
  }

  .custom-form__file-remove-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: rgb(var(--color-foreground-rgb) / 0.6);
    cursor: pointer;
    flex-shrink: 0;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .custom-form__file-remove-btn:hover {
    color: var(--color-error, #dc2626);
    background-color: rgb(var(--color-foreground-rgb) / 0.08);
  }

  .custom-form__file-remove-btn:focus-visible {
    outline: var(--focus-outline-width, 2px) solid var(--color-foreground);
    outline-offset: 1px;
  }

  /* Grid Layout */
  .custom-form__file-list--grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
    align-items: flex-start;
  }

  .custom-form__file-card--grid {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 6px;
    width: fit-content;
    max-width: calc(var(--thumb-size, 64px) + 16px);
    border: var(--form-file-card-border-width, 1px) solid var(--form-file-card-border, rgb(var(--color-foreground-rgb) / 0.12));
    border-radius: var(--form-file-card-radius, var(--form-file-radius, var(--style-border-radius-inputs, 6px)));
    background-color: var(--form-file-card-bg, var(--color-input-background, var(--color-background)));
    cursor: pointer;
    box-sizing: border-box;
    text-align: center;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .custom-form__file-card--grid .custom-form__file-thumb-box {
    width: var(--thumb-size, 64px);
    height: var(--thumb-size, 64px);
    margin-bottom: 4px;
    flex-shrink: 0;
  }

  .custom-form__file-card--grid .custom-form__file-name {
    font-size: calc(var(--font-paragraph--size, 14px) * 0.8);
    color: var(--form-file-card-text, var(--color-foreground));
    width: 100%;
    max-width: var(--thumb-size, 64px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .custom-form__file-card--grid .custom-form__file-remove-btn {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 20px;
    height: 20px;
    background-color: rgba(0, 0, 0, 0.65);
    color: #fff;
    border-radius: 50%;
    z-index: 2;
    padding: 0;
  }

  .custom-form__file-card--grid .custom-form__file-remove-btn:hover {
    background-color: var(--color-error, #dc2626);
    color: #fff;
  }

  /* Compact Layout */
  .custom-form__file-list--compact {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .custom-form__file-card--compact {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border-radius: 9999px;
    border: var(--form-file-card-border-width, 1px) solid var(--form-file-card-border, rgb(var(--color-foreground-rgb) / 0.12));
    background-color: var(--form-file-card-bg, var(--color-input-background, var(--color-background)));
    cursor: pointer;
    font-size: calc(var(--font-paragraph--size, 14px) * 0.85);
    transition: border-color 0.15s ease;
  }

  .custom-form__file-card--compact .custom-form__file-name {
    max-width: 140px;
    color: var(--form-file-card-text, var(--color-foreground));
  }

  .custom-form__file-compact-icon {
    display: flex;
    align-items: center;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .custom-form__file-compact-icon svg {
    width: 16px;
    height: 16px;
  }

  .custom-form__file-size {
    font-size: calc(var(--font-paragraph--size, 14px) * 0.75);
    color: var(--form-file-card-meta, rgb(var(--color-foreground-rgb) / 0.6));
  }

  .custom-form__file-card--compact .custom-form__file-remove-btn {
    width: 18px;
    height: 18px;
    margin-left: 2px;
  }

  /* Add More Buttons */
  .custom-form__file-add-btn {
    border: none;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    padding: 0;
  }

  .custom-form__file-add-btn--grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 6px;
    width: fit-content;
    max-width: calc(var(--thumb-size, 64px) + 16px);
    border: 1.5px dashed var(--form-file-card-border, rgb(var(--color-foreground-rgb) / 0.2));
    border-radius: var(--form-file-card-radius, var(--form-file-radius, var(--style-border-radius-inputs, 6px)));
    background-color: transparent;
    cursor: pointer;
    box-sizing: border-box;
    text-align: center;
    color: var(--form-file-card-text, var(--color-foreground));
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .custom-form__file-add-btn--grid:hover {
    border-color: var(--color-foreground);
    background-color: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .custom-form__file-add-btn--grid .custom-form__file-name {
    font-size: calc(var(--font-paragraph--size, 14px) * 0.8);
    color: var(--form-file-card-text, var(--color-foreground));
    width: 100%;
    max-width: var(--thumb-size, 64px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .custom-form__file-thumb-box--add {
    width: var(--thumb-size, 64px);
    height: var(--thumb-size, 64px);
    margin-bottom: 4px;
    background-color: rgb(var(--color-foreground-rgb) / 0.03);
    border-radius: calc(var(--form-file-card-radius, var(--form-file-radius, var(--style-border-radius-inputs, 6px))) * 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgb(var(--color-foreground-rgb) / 0.7);
    flex-shrink: 0;
  }

  .custom-form__file-add-btn--list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 14px;
    border: 1.5px dashed var(--form-file-card-border, rgb(var(--color-foreground-rgb) / 0.2));
    border-radius: var(--form-file-card-radius, var(--form-file-radius, var(--style-border-radius-inputs, 6px)));
    background-color: transparent;
    cursor: pointer;
    color: var(--form-file-card-text, var(--color-foreground));
    font-size: calc(var(--font-paragraph--size, 14px) * 0.9);
    font-weight: 500;
    transition: border-color 0.15s ease, background-color 0.15s ease;
    width: 100%;
    box-sizing: border-box;
  }

  .custom-form__file-add-btn--list:hover {
    border-color: var(--color-foreground);
    background-color: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .custom-form__file-add-btn--compact {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 9999px;
    border: 1.5px dashed var(--form-file-card-border, rgb(var(--color-foreground-rgb) / 0.2));
    background-color: transparent;
    cursor: pointer;
    color: var(--form-file-card-text, var(--color-foreground));
    font-size: calc(var(--font-paragraph--size, 14px) * 0.85);
    font-weight: 500;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .custom-form__file-add-btn--compact:hover {
    border-color: var(--color-foreground);
    background-color: rgb(var(--color-foreground-rgb) / 0.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .custom-form__file-dropzone,
    .custom-form__file-card--list,
    .custom-form__file-card--grid,
    .custom-form__file-card--compact {
      transition: none;
    }
  }
{% endstylesheet %}
