{%- comment -%}
  Brands & Logo List Section
  Renders a clean, responsive, and accessible brand logo bar using native theme blocks with multiple layout options and hover effects.
{%- endcomment -%}

{% render 'brands-styles' %}

{%- liquid
  assign section_settings = section.settings

  if section_settings.background_color != blank
    render 'contrast-override', background_color: section_settings.background_color, section_id: section.id
  endif
-%}

<div
  class="section-background{% if section_settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  id="Brands-{{ section.id }}"
  class="section section--{{ section_settings.section_width }} disable-section-top-offset brands-section{% if section_settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} spacing-style"
  style="
    --brands-logo-height: {{ section_settings.logo_height }}px;
    --brands-logo-height-mobile: {{ section_settings.logo_height_mobile }}px;
    --brands-logo-max-width: {{ section_settings.logo_max_width }}px;
    --brands-gap: {{ section_settings.gap }}px;
    --brands-gap-mobile: {{ section_settings.gap_mobile }}px;
    --brands-opacity: {{ section_settings.logo_opacity | divided_by: 100.0 }};
    --brands-hover-opacity: {{ section_settings.logo_hover_opacity | divided_by: 100.0 }};
    --brands-grid-mobile-cols: {{ section_settings.grid_mobile_columns }};
    {% if section_settings.text_color != blank %}--color-foreground: {{ section_settings.text_color }};{% endif %}
    {% render 'spacing-style', settings: section_settings %}
  "
>
  <div class="brands brands--grayscale-{{ section_settings.grayscale_mode }}{% if section_settings.hover_effect != 'none' %} brands--hover-{{ section_settings.hover_effect }}{% endif %}">
    {% content_for 'block', type: 'group', id: 'static-header' %}

    <div
      class="
        brands__items
        brands__items--{{ section_settings.alignment }}
        brands__items--{{ section_settings.mobile_layout }}-mobile
      "
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brands & Logo List",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header"]
  },
  "blocks": [
    {
      "type": "image"
    },
    {
      "type": "text"
    },
    {
      "type": "_heading"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Logo alignment",
      "options": [
        {
          "value": "space-between",
          "label": "Space between (Spread evenly)"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "space-around",
          "label": "Space around"
        },
        {
          "value": "space-evenly",
          "label": "Space evenly"
        },
        {
          "value": "flex-start",
          "label": "Left"
        }
      ],
      "default": "space-between"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height (Desktop)",
      "min": 15,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo height (Mobile)",
      "min": 12,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Logo max width",
      "min": 50,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between logos (Desktop)",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap between logos (Mobile)",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Mobile Layout"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "scroll",
          "label": "Horizontal swipe scroll"
        },
        {
          "value": "wrap",
          "label": "Wrap in rows"
        },
        {
          "value": "grid",
          "label": "Grid columns"
        }
      ],
      "default": "scroll"
    },
    {
      "type": "range",
      "id": "grid_mobile_columns",
      "label": "Columns on mobile (Grid mode)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "visible_if": "{{ section.settings.mobile_layout == 'grid' }}"
    },
    {
      "type": "header",
      "content": "Appearance & Effects"
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Logo opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "range",
      "id": "logo_hover_opacity",
      "label": "Logo hover opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "grayscale_mode",
      "label": "Grayscale filter",
      "options": [
        {
          "value": "none",
          "label": "None (Full color)"
        },
        {
          "value": "always",
          "label": "Always grayscale"
        },
        {
          "value": "hover",
          "label": "Grayscale (Color on hover)"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "Hover animation",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade opacity"
        },
        {
          "value": "scale",
          "label": "Subtle scale"
        },
        {
          "value": "lift",
          "label": "Lift upward"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Brands & Logo List",
      "category": "t:categories.basic",
      "blocks": {
        "static-header": {
          "type": "group",
          "name": "t:names.header",
          "static": true,
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": false,
            "horizontal_alignment": "center",
            "vertical_alignment": "center",
            "align_baseline": true,
            "gap": 12,
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "custom_height": 100,
            "border": "none",
            "padding-block-start": 0,
            "padding-block-end": 24,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "heading": {
              "type": "text",
              "name": "t:names.heading",
              "settings": {
                "text": "<h3>Featured Brands</h3>",
                "type_preset": "h3",
                "width": "fit-content",
                "alignment": "center"
              }
            }
          },
          "block_order": ["heading"]
        },
        "image_1": {
          "type": "image",
          "settings": {
            "object_fit": "contain",
            "width": "fit-content",
            "width_mobile": "fit-content"
          }
        },
        "image_2": {
          "type": "image",
          "settings": {
            "object_fit": "contain",
            "width": "fit-content",
            "width_mobile": "fit-content"
          }
        },
        "image_3": {
          "type": "image",
          "settings": {
            "object_fit": "contain",
            "width": "fit-content",
            "width_mobile": "fit-content"
          }
        },
        "image_4": {
          "type": "image",
          "settings": {
            "object_fit": "contain",
            "width": "fit-content",
            "width_mobile": "fit-content"
          }
        },
        "image_5": {
          "type": "image",
          "settings": {
            "object_fit": "contain",
            "width": "fit-content",
            "width_mobile": "fit-content"
          }
        },
        "image_6": {
          "type": "image",
          "settings": {
            "object_fit": "contain",
            "width": "fit-content",
            "width_mobile": "fit-content"
          }
        },
        "image_7": {
          "type": "image",
          "settings": {
            "object_fit": "contain",
            "width": "fit-content",
            "width_mobile": "fit-content"
          }
        }
      },
      "block_order": ["image_1", "image_2", "image_3", "image_4", "image_5", "image_6", "image_7"]
    }
  ]
}
{% endschema %}
