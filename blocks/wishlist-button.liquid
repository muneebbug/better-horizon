{% doc %}
  Wishlist Button Block
  Renders a wishlist toggle button conforming strictly to Horizon's typography, colors, and button styles.
{% enddoc %}

{%- liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign featured_image_url = ''
  if product.featured_image
    assign featured_image_url = product.featured_image | image_url: width: 200
  endif

  assign selected_variant = product.selected_or_first_available_variant
-%}

<script
  src="{{ 'wishlist.js' | asset_url }}"
  defer
  type="module"
></script>

<wishlist-button
  class="wishlist-button-block wishlist-button-block--{{ block.id }}"
  data-product-id="{{ product.id }}"
  data-variant-id="{{ selected_variant.id }}"
  data-product-handle="{{ product.handle }}"
  data-product-title="{{ product.title | escape }}"
  data-product-price="{{ product.price | money | strip_html }}"
  data-product-image="{{ featured_image_url }}"
  data-product-url="{{ product.url }}"
  {{ block.shopify_attributes }}
>
  <button
    type="button"
    class="wishlist-button {{ block.settings.style_class }}"
    aria-pressed="false"
    aria-label="Add to wishlist: {{ product.title | escape }}"
  >
    <span class="wishlist-button__icon-wrapper" aria-hidden="true">
      <svg
        class="wishlist-button__icon wishlist-button__icon--empty"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
      <svg
        class="wishlist-button__icon wishlist-button__icon--filled"
        viewBox="0 0 24 24"
        fill="currentColor"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
    </span>
    {%- if block.settings.show_label -%}
      <span class="wishlist-button__text button-text">
        <span class="wishlist-button__text--add">{{ block.settings.label_add }}</span>
        <span class="wishlist-button__text--remove">{{ block.settings.label_remove }}</span>
      </span>
    {%- endif -%}
  </button>
</wishlist-button>

{% stylesheet %}
  .wishlist-button-block {
    display: inline-block;
    margin: var(--margin-xs, 8px) 0;
  }

  .wishlist-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-xs, 8px);
    cursor: pointer;
    font-family: inherit;
    font-size: var(--font-body--size, 14px);
    min-height: var(--minimum-touch-target, 44px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  /* Icon-Only Style */
  .wishlist-button.wishlist-button--icon-only {
    width: var(--minimum-touch-target, 44px);
    height: var(--minimum-touch-target, 44px);
    padding: 0;
    background: transparent;
    border: var(--style-border-width, 1px) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25, 0.2));
    border-radius: var(--style-border-radius-buttons-secondary, 9999px);
    color: var(--color-foreground);
  }

  .wishlist-button.wishlist-button--icon-only:hover {
    border-color: var(--color-foreground);
    background-color: rgb(var(--color-foreground-rgb) / 0.05);
  }

  /* Primary Button Style */
  .wishlist-button.button {
    padding: 0 var(--padding-xl, 24px);
    border-radius: var(--style-border-radius-buttons-primary, 9999px);
    height: var(--height-buy-buttons, 44px);
  }

  /* Secondary Button Style */
  .wishlist-button.button-secondary {
    padding: 0 var(--padding-xl, 24px);
    border-radius: var(--style-border-radius-buttons-secondary, 9999px);
    height: var(--height-buy-buttons, 44px);
  }

  .wishlist-button__icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
  }

  .wishlist-button__icon {
    width: 100%;
    height: 100%;
    transition: transform 0.2s ease;
  }

  .wishlist-button__icon--filled {
    display: none;
  }

  wishlist-button[data-active="true"] .wishlist-button__icon--empty {
    display: none;
  }

  wishlist-button[data-active="true"] .wishlist-button__icon--filled {
    display: block;
    color: #e53e3e;
  }

  .wishlist-button__text--remove {
    display: none;
  }

  wishlist-button[data-active="true"] .wishlist-button__text--add {
    display: none;
  }

  wishlist-button[data-active="true"] .wishlist-button__text--remove {
    display: inline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Wishlist button",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show button label",
      "default": false
    },
    {
      "type": "text",
      "id": "label_add",
      "label": "Add to wishlist text",
      "default": "Add to wishlist",
      "visible_if": "{{ block.settings.show_label }}"
    },
    {
      "type": "text",
      "id": "label_remove",
      "label": "Remove from wishlist text",
      "default": "Saved in wishlist",
      "visible_if": "{{ block.settings.show_label }}"
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "Button style",
      "options": [
        {
          "value": "wishlist-button--icon-only",
          "label": "Icon only"
        },
        {
          "value": "button",
          "label": "Primary button"
        },
        {
          "value": "button-secondary",
          "label": "Secondary button"
        }
      ],
      "default": "wishlist-button--icon-only"
    }
  ],
  "presets": [
    {
      "name": "Wishlist button"
    }
  ]
}
{% endschema %}
