{% doc %}
  Cart Upsell Block
  Displays product recommendations on the cart page or within sections with complete layout, sizing, and styling controls.
{% enddoc %}

{%- liquid
  assign block_settings = block.settings
  assign card_style = block_settings.card_style | default: 'default'
  assign button_style = block_settings.button_style | default: 'secondary'
  assign image_size = block_settings.image_size | default: 50
  assign image_radius = block_settings.image_border_radius | default: 6
  assign gap_size = block_settings.gap | default: 10

  assign style_class = 'button--' | append: button_style
  if button_style == 'custom'
    assign style_class = 'button--custom'
  endif
-%}

{%- style -%}
  .cart-upsell-block--{{ block.id }} {
    {% if card_style == 'custom' %}
      {% if block_settings.background_color != blank %}
        --upsell-card-bg: {{ block_settings.background_color }};
      {% endif %}
      {% if block_settings.border_color != blank %}
        --upsell-card-border: {{ block_settings.border_color }};
      {% endif %}
      {% if block_settings.border_width != blank %}
        --upsell-border-width: {{ block_settings.border_width }}px;
      {% endif %}
      {% if block_settings.border_radius != blank %}
        --upsell-border-radius: {{ block_settings.border_radius }}px;
      {% endif %}
    {% elsif card_style == 'minimal' %}
      --upsell-card-bg: transparent;
      --upsell-card-border: transparent;
      --upsell-border-width: 0px;
    {% elsif card_style == 'outline' %}
      --upsell-card-bg: transparent;
    {% endif %}

    --upsell-img-size: {{ image_size }}px;
    --upsell-img-radius: {{ image_radius }}px;
    --upsell-gap: {{ gap_size }}px;

    {% if block_settings.heading_color != blank %}
      --upsell-heading-color: {{ block_settings.heading_color }};
    {% endif %}
    {% if block_settings.product_title_color != blank %}
      --upsell-title-color: {{ block_settings.product_title_color }};
    {% endif %}
    {% if block_settings.price_color != blank %}
      --upsell-price-color: {{ block_settings.price_color }};
    {% endif %}
  }

  {% if button_style == 'custom' %}
    .cart-upsell-block--{{ block.id }} .cart-upsell-card__add-btn {
      {% if block_settings.button_background_color != blank %}
        background-color: {{ block_settings.button_background_color }};
      {% endif %}
      {% if block_settings.button_text_color != blank %}
        color: {{ block_settings.button_text_color }};
      {% endif %}
      {% if block_settings.button_border_color != blank %}
        border-color: {{ block_settings.button_border_color }};
      {% endif %}
      {% if block_settings.button_border_radius != blank %}
        border-radius: {{ block_settings.button_border_radius }}px;
      {% endif %}
    }
  {% endif %}
{%- endstyle -%}

<div
  class="cart-upsell-block cart-upsell-block--{{ block.id }} spacing-style text-{{ block_settings.alignment }}"
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  {% render 'cart-upsell',
    context: 'page',
    heading: block_settings.heading,
    type_preset: block_settings.type_preset,
    alignment: block_settings.alignment,
    layout: block_settings.layout,
    limit: block_settings.products_to_show,
    style_class: style_class,
    block: block
  %}
</div>

{% stylesheet %}
  .cart-upsell-block {
    display: block;
    width: 100%;
    align-self: stretch;
    box-sizing: border-box;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart upsell",
  "settings": [
    {
      "type": "paragraph",
      "content": "Displays personalized complementary product recommendations with quick variant selection and 1-click add to cart."
    },
    {
      "type": "header",
      "content": "Content & Headings"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Recommended for you"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "options": [
        {
          "value": "list",
          "label": "List (vertical stacked rows)"
        },
        {
          "value": "slider",
          "label": "Horizontal carousel"
        },
        {
          "value": "grid_2",
          "label": "2 column grid"
        }
      ],
      "default": "slider"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Items to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Sizing & Spacing"
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Product thumbnail size",
      "min": 40,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Product thumbnail corner radius",
      "min": 0,
      "max": 16,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Spacing between cards",
      "min": 6,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Card Style & Colors"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card container style",
      "options": [
        {
          "value": "default",
          "label": "Default card"
        },
        {
          "value": "minimal",
          "label": "Minimal (borderless / transparent)"
        },
        {
          "value": "outline",
          "label": "Outline only"
        },
        {
          "value": "custom",
          "label": "Custom colors"
        }
      ],
      "default": "default"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Card background color",
      "visible_if": "{{ block.settings.card_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border color",
      "visible_if": "{{ block.settings.card_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Card border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.card_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ block.settings.card_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Product title color"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color"
    },
    {
      "type": "header",
      "content": "Button Styling"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style preset",
      "options": [
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "secondary"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Custom button background",
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Custom button text color",
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Custom button border color",
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "t:settings.preset",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        }
      ],
      "default": "h4",
      "info": "t:info.edit_presets_in_theme_settings"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Cart upsell"
    }
  ]
}
{% endschema %}
