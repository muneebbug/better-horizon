{% doc %}
  Form Checkbox Block
  Renders a single checkbox input for agreements, subscriptions, or optional confirmations.
{% enddoc %}

{%- liquid
  assign block_settings = block.settings
  assign field_id = 'FormField-Checkbox-' | append: block.id
  assign raw_name = block_settings.name | default: 'newsletter'
  assign name_type = block_settings.name_type | default: 'contact'

  case name_type
    when 'contact'
      if raw_name contains 'contact['
        assign field_name = raw_name
      else
        assign field_name = 'contact[' | append: raw_name | append: ']'
      endif
    when 'property'
      if raw_name contains 'properties['
        assign field_name = raw_name
      else
        assign field_name = 'properties[' | append: raw_name | append: ']'
      endif
    when 'attribute'
      if raw_name contains 'attributes['
        assign field_name = raw_name
      else
        assign field_name = 'attributes[' | append: raw_name | append: ']'
      endif
    when 'custom'
      assign field_name = raw_name
  endcase

  assign field_label = block_settings.label | default: 'Subscribe to newsletter'
  assign field_value = block_settings.value | default: 'Yes'
  assign field_width = block_settings.width | default: '100'
  assign help_id = 'FormField-Help-' | append: block.id

  assign size_val = '18px'
  case block_settings.checkbox_size
    when 'small'
      assign size_val = '15px'
    when 'large'
      assign size_val = '22px'
  endcase
-%}

{% render 'checkbox-styles' %}
{% render 'custom-form-styles' %}

<div
  class="custom-form__field custom-form__field--width-{{ field_width }} spacing-style"
  style="
    --checkbox-size: {{ size_val }};
    {% render 'spacing-style', settings: block_settings %}
    {% if block_settings.override_colors %}
      {% if block_settings.checkbox_active_color != blank %}--color-foreground: {{ block_settings.checkbox_active_color }};{% endif %}
      {% if block_settings.checkbox_border_color != blank %}--color-input-border: {{ block_settings.checkbox_border_color }};{% endif %}
      {% if block_settings.checkbox_text_color != blank %}color: {{ block_settings.checkbox_text_color }};{% endif %}
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  <div class="checkbox">
    <input
      type="checkbox"
      id="{{ field_id }}"
      name="{{ field_name }}"
      value="{{ field_value | escape }}"
      class="checkbox__input"
      {% if block_settings.checked_by_default %}
        checked
      {% endif %}
      {% if block_settings.required %}
        required
        aria-required="true"
      {% endif %}
      {% if block_settings.help_text != blank %}
        aria-describedby="{{ help_id }}"
      {% endif %}
    >
    <label class="checkbox__label" for="{{ field_id }}">
      {{ 'icon-checkmark.svg' | inline_asset_content }}
      <span class="checkbox__label-text">
        {{- field_label -}}
        {%- if block_settings.required -%}
          <span class="custom-form__required-mark" aria-hidden="true">*</span>
        {%- endif -%}
      </span>
    </label>
  </div>

  {%- if block_settings.help_text != blank -%}
    <span
      id="{{ help_id }}"
      class="custom-form__help-text"
      style="margin-inline-start: calc(var(--checkbox-size) + var(--checkbox-label-padding, 8px));"
    >
      {{- block_settings.help_text -}}
    </span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Checkbox",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "name_type",
      "label": "Field purpose",
      "options": [
        {
          "value": "contact",
          "label": "Contact form (contact[...])"
        },
        {
          "value": "property",
          "label": "Line item property (properties[...])"
        },
        {
          "value": "attribute",
          "label": "Cart attribute (attributes[...])"
        },
        {
          "value": "custom",
          "label": "Custom (no wrapper)"
        }
      ],
      "default": "contact",
      "info": "Contact: for contact/inquiry forms. Line item property: for custom product add-ons (gift wrap, insurance). Cart attribute: for cart-level order options. Custom: exact HTML name."
    },
    {
      "type": "text",
      "id": "name",
      "label": "Field name",
      "default": "newsletter",
      "info": "Field key (e.g. newsletter, terms, Gift Wrap, or include_receipt). Brackets are added automatically based on purpose."
    },
    {
      "type": "inline_richtext",
      "id": "label",
      "label": "Label",
      "default": "Subscribe to our newsletter"
    },
    {
      "type": "text",
      "id": "value",
      "label": "Checked value",
      "default": "Yes"
    },
    {
      "type": "checkbox",
      "id": "checked_by_default",
      "label": "Checked by default",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "required",
      "label": "Required field",
      "default": false
    },
    {
      "type": "select",
      "id": "checkbox_size",
      "label": "Checkbox size",
      "options": [
        {
          "value": "small",
          "label": "Small (15px)"
        },
        {
          "value": "medium",
          "label": "Medium (18px)"
        },
        {
          "value": "large",
          "label": "Large (22px)"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Field width",
      "options": [
        {
          "value": "100",
          "label": "Full width (100%)"
        },
        {
          "value": "50",
          "label": "Half width (50%)"
        },
        {
          "value": "auto",
          "label": "Auto"
        }
      ],
      "default": "100"
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Helper text"
    },
    {
      "type": "header",
      "content": "Custom Styling Override"
    },
    {
      "type": "checkbox",
      "id": "override_colors",
      "label": "Override colors for this checkbox",
      "default": false
    },
    {
      "type": "color",
      "id": "checkbox_active_color",
      "label": "Active fill color",
      "visible_if": "{{ block.settings.override_colors }}"
    },
    {
      "type": "color",
      "id": "checkbox_border_color",
      "label": "Border color",
      "visible_if": "{{ block.settings.override_colors }}"
    },
    {
      "type": "color",
      "id": "checkbox_text_color",
      "label": "Label text color",
      "visible_if": "{{ block.settings.override_colors }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Checkbox",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
