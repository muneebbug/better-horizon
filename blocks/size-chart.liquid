{% doc %}
  Dynamic Size Chart Block
  Renders an accessible size guide trigger button and modal dialog.
  Retrieves content dynamically from a selected Shopify Page or product metafield ('custom.size_chart').
  If no content is found or configured, the block remains completely hidden.
{% enddoc %}

{%- liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign size_chart_content = ''
  assign source = block.settings.content_source | default: 'auto'

  if source == 'page' and block.settings.page != blank
    assign size_chart_content = block.settings.page.content
  elsif source == 'metafield'
    assign metafield_data = product.metafields.custom.size_chart.value
    if metafield_data.content != blank
      assign size_chart_content = metafield_data.content
    elsif metafield_data != blank
      assign size_chart_content = metafield_data
    endif
  elsif source == 'auto'
    assign metafield_data = product.metafields.custom.size_chart.value
    if metafield_data.content != blank
      assign size_chart_content = metafield_data.content
    elsif metafield_data != blank
      assign size_chart_content = metafield_data
    elsif block.settings.page != blank
      assign size_chart_content = block.settings.page.content
    endif
  endif
-%}

{%- if size_chart_content != blank or request.design_mode -%}
  <div
    class="size-chart-block size-chart-block--{{ block.id }}"
    {{ block.shopify_attributes }}
  >
    {%- if size_chart_content != blank -%}
      <button
        type="button"
        class="size-chart-trigger"
        aria-haspopup="dialog"
        aria-controls="SizeChartDialog-{{ block.id }}"
        onclick="document.getElementById('SizeChartDialog-{{ block.id }}')?.showModal()"
      >
        <span class="svg-wrapper size-chart-trigger__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.3 8.7 8.7 21.3c-1 1-2.5 1-3.4 0l-2.6-2.6c-1-1-1-2.5 0-3.4L15.3 2.7c1-1 2.5-1 3.4 0l2.6 2.6c1 1 1 2.5 0 3.4Z"></path>
            <path d="m14.5 5.5-2.5 2.5"></path>
            <path d="m11.5 8.5-1.5 1.5"></path>
            <path d="m8.5 11.5-2.5 2.5"></path>
            <path d="m5.5 14.5-1.5 1.5"></path>
          </svg>
        </span>
        <span>{{ block.settings.button_label }}</span>
      </button>

      <dialog
        id="SizeChartDialog-{{ block.id }}"
        class="size-chart-dialog"
        aria-label="{{ block.settings.heading }}"
      >
        <div class="size-chart-dialog__inner">
          <div class="size-chart-dialog__header">
            <h2 class="size-chart-dialog__title">{{ block.settings.heading }}</h2>
            <button
              type="button"
              class="size-chart-dialog__close"
              onclick="document.getElementById('SizeChartDialog-{{ block.id }}')?.close()"
              aria-label="Close size guide"
            >
              <span class="svg-wrapper">
                {{ 'icon-close.svg' | inline_asset_content }}
              </span>
            </button>
          </div>

          {%- if block.settings.description != blank -%}
            <div class="size-chart-dialog__description">
              <p>{{ block.settings.description }}</p>
            </div>
          {%- endif -%}

          <div class="size-chart-dialog__content rte">
            {{ size_chart_content }}
          </div>
        </div>
      </dialog>
    {%- elsif request.design_mode -%}
      <div class="size-chart-editor-notice">
        <span>📏 <strong>Size Chart:</strong> Select a page or add a <code>custom.size_chart</code> metafield to display.</span>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .size-chart-block {
    display: inline-block;
    margin: var(--margin-xs, 8px) 0;
  }

  .size-chart-editor-notice {
    font-size: var(--font-size--xs, 12px);
    color: var(--color-foreground-subdued, rgb(var(--color-foreground-rgb) / 0.7));
    border: 1px dashed rgb(var(--color-foreground-rgb) / 0.3);
    padding: 8px 12px;
    border-radius: var(--style-border-radius-inputs, 6px);
  }

  .size-chart-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-xs, 6px);
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: var(--font-body--size, 14px);
    text-decoration: underline;
    text-underline-offset: 3px;
    color: inherit;
    padding: 6px 0;
    min-height: 44px;
  }

  .size-chart-trigger:hover {
    opacity: 0.8;
  }

  .size-chart-trigger__icon {
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
  }

  .size-chart-dialog {
    border: var(--style-border-width, 1px) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25, 0.15));
    border-radius: var(--style-border-radius-inputs, 8px);
    padding: 0;
    width: min(580px, 90vw);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .size-chart-dialog::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
  }

  .size-chart-dialog__inner {
    padding: var(--padding-lg, 24px);
  }

  .size-chart-dialog__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--margin-md, 16px);
  }

  .size-chart-dialog__title {
    margin: 0;
    font-size: var(--font-body--size, 18px);
    font-weight: 600;
  }

  .size-chart-dialog__close {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--color-foreground);
  }

  .size-chart-dialog__description {
    margin-bottom: var(--margin-md, 16px);
    font-size: var(--font-body--size, 14px);
    color: var(--color-foreground-subdued, rgb(var(--color-foreground-rgb) / 0.7));
  }

  .size-chart-dialog__content {
    font-size: var(--font-body--size, 14px);
    line-height: 1.6;
    color: var(--color-foreground);
    max-height: 60vh;
    overflow-y: auto;
  }

  .size-chart-dialog__content table {
    width: 100%;
    border-collapse: collapse;
    margin: var(--margin-md, 16px) 0;
  }

  .size-chart-dialog__content th,
  .size-chart-dialog__content td {
    padding: 10px 14px;
    border: var(--style-border-width, 1px) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25, 0.15));
    text-align: left;
  }

  .size-chart-dialog__content thead th {
    background-color: rgb(var(--color-foreground-rgb) / 0.03);
    font-weight: 600;
  }

  .size-chart-dialog__content img {
    max-width: 100%;
    height: auto;
    border-radius: var(--style-border-radius-inputs, 6px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Size chart guide",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Size Guide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Modal heading",
      "default": "Size & Measurement Guide"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Refer to the measurements below to find your perfect fit."
    },
    {
      "type": "header",
      "content": "Content Source"
    },
    {
      "type": "select",
      "id": "content_source",
      "label": "Size chart source",
      "options": [
        {
          "value": "auto",
          "label": "Auto (Metafield first, then Page)"
        },
        {
          "value": "page",
          "label": "Shopify Page"
        },
        {
          "value": "metafield",
          "label": "Product Metafield (custom.size_chart)"
        }
      ],
      "default": "auto",
      "info": "If no content is found in the selected source, the button will not render on product pages."
    },
    {
      "type": "page",
      "id": "page",
      "label": "Size chart page",
      "info": "Select a Shopify page containing sizing charts, rich text, images, or tables."
    },
    {
      "type": "paragraph",
      "content": "To set product-specific charts, add a product metafield with namespace and key 'custom.size_chart' (type: Rich Text, Single Line Text, or Page Reference)."
    }
  ],
  "presets": [
    {
      "name": "Size chart guide"
    }
  ]
}
{% endschema %}
