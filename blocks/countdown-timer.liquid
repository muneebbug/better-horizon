{% doc %}
  Real Date Countdown Timer Block
  Displays a countdown timer strictly bound to verified promotional or metafield dates.
{% enddoc %}

{%- liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign end_date = product.metafields.custom.sale_end_date.value | default: block.settings.end_date
-%}

<script
  src="{{ 'countdown-timer.js' | asset_url }}"
  defer
  type="module"
></script>

{%- if end_date != blank or request.design_mode -%}
  <div
    class="countdown-block countdown-block--{{ block.id }}"
    {{ block.shopify_attributes }}
  >
    <countdown-timer
      class="countdown-timer"
      data-end-time="{{ end_date | default: '2028-12-31T23:59:59Z' }}"
    >
      {%- if block.settings.heading != blank -%}
        <div class="countdown-timer__heading">
          <span class="svg-wrapper countdown-timer__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </span>
          <span>{{ block.settings.heading }}</span>
        </div>
      {%- endif -%}

      <div class="countdown-timer__digits" role="timer" aria-live="off">
        <span class="countdown-unit">
          <strong data-days class="countdown-num">00</strong><span class="countdown-label">d</span>
        </span>
        <span class="countdown-separator">:</span>
        <span class="countdown-unit">
          <strong data-hours class="countdown-num">00</strong><span class="countdown-label">h</span>
        </span>
        <span class="countdown-separator">:</span>
        <span class="countdown-unit">
          <strong data-minutes class="countdown-num">00</strong><span class="countdown-label">m</span>
        </span>
        <span class="countdown-separator">:</span>
        <span class="countdown-unit">
          <strong data-seconds class="countdown-num">00</strong><span class="countdown-label">s</span>
        </span>
      </div>
    </countdown-timer>
  </div>
{%- endif -%}

{% stylesheet %}
  .countdown-block {
    margin: 0;
    padding: 10px 16px;
    background-color: rgb(var(--color-foreground-rgb) / 0.03);
    border: var(--style-border-width, 1px) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25, 0.15));
    border-radius: var(--style-border-radius-inputs, 8px);
    display: block;
    width: 100%;
    box-sizing: border-box;
    color: var(--color-foreground);
  }

  .countdown-timer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-sm, 12px);
    flex-wrap: wrap;
  }

  .countdown-timer__heading {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-xs, 6px);
    font-size: var(--font-body--size, 14px);
    font-weight: 600;
    color: var(--color-foreground);
    letter-spacing: -0.01em;
  }

  .countdown-timer__icon {
    width: 16px;
    height: 16px;
    color: var(--color-foreground);
    flex-shrink: 0;
  }

  .countdown-timer__digits {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-variant-numeric: tabular-nums;
  }

  .countdown-unit {
    display: inline-flex;
    align-items: baseline;
    gap: 1px;
  }

  .countdown-num {
    font-size: var(--font-body--size, 15px);
    font-weight: 700;
    color: var(--color-foreground);
    font-variant-numeric: tabular-nums;
  }

  .countdown-label {
    font-size: var(--font-size--2xs, 11px);
    font-weight: 500;
    color: var(--color-foreground-subdued, rgb(var(--color-foreground-rgb) / 0.65));
    margin-inline-end: 2px;
  }

  .countdown-separator {
    font-size: var(--font-body--size, 13px);
    font-weight: 600;
    color: var(--color-foreground-subdued, rgb(var(--color-foreground-rgb) / 0.4));
    margin: 0 1px;
  }

  @media screen and (max-width: 420px) {
    .countdown-timer {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Countdown timer",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Limited Time Offer"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End date (ISO format)",
      "info": "Example: 2026-12-31T23:59:59Z. Can also be set dynamically via product metafield 'sale_end_date'."
    }
  ],
  "presets": [
    {
      "name": "Countdown timer"
    }
  ]
}
{% endschema %}
