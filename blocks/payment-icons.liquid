{% doc %}
  Payment Methods Block
  Renders all enabled payment icons with optional heading, security lock icon, alignment, and color mode settings.
{% enddoc %}

{%- liquid
  assign block_settings = block.settings
  assign enabled_payment_types = shop.enabled_payment_types
  if enabled_payment_types == empty and request.design_mode
    assign enabled_payment_types = 'visa,master,american_express,paypal,apple_pay,google_pay,shopify_pay' | split: ','
  endif
-%}

{%- if enabled_payment_types != empty -%}
  <div
    class="payment-icons-block payment-icons-block--{{ block.id }} payment-icons-block--{{ block_settings.color_mode | default: 'color' }}"
    style="
      --icon-alignment: {{ block_settings.horizontal_alignment | default: 'flex-start' }};
      --icon-gap: {{ block_settings.gap | default: 8 }}px;
    "
    {{ block.shopify_attributes }}
  >
    {%- if block_settings.heading != blank -%}
      <div class="payment-icons__header">
        {%- if block_settings.show_lock_icon -%}
          <span class="svg-wrapper payment-icons__lock-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </span>
        {%- endif -%}
        <span class="payment-icons__heading">{{ block_settings.heading }}</span>
      </div>
    {%- endif -%}

    <span class="visually-hidden">{{ 'blocks.payment_methods' | t | default: 'Accepted Payment Methods' }}</span>
    <ul
      class="payment-icons__list payment-icons__list--{{ block_settings.icon_size | default: 'medium' }}"
      role="list"
    >
      {%- for type in enabled_payment_types -%}
        <li class="payment-icons__item">
          {{ type | payment_type_svg_tag: class: 'payment-icon' }}
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .payment-icons-block {
    margin: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .payment-icons__header {
    display: flex;
    align-items: center;
    justify-content: var(--icon-alignment);
    gap: var(--gap-xs, 6px);
    margin-bottom: var(--margin-xs, 8px);
    font-size: var(--font-body--size, 13px);
    font-weight: 500;
    color: var(--color-foreground-subdued, rgb(var(--color-foreground-rgb) / 0.7));
  }

  .payment-icons__lock-icon {
    width: 14px;
    height: 14px;
    display: inline-flex;
    align-items: center;
    color: var(--color-foreground-subdued, rgb(var(--color-foreground-rgb) / 0.7));
  }

  .payment-icons__list {
    display: flex;
    align-items: center;
    justify-content: var(--icon-alignment);
    flex-wrap: wrap;
    gap: var(--icon-gap, 8px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .payment-icons__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .payment-icons__list--small .payment-icon {
    height: 20px;
    width: auto;
  }

  .payment-icons__list--medium .payment-icon {
    height: 24px;
    width: auto;
  }

  .payment-icons__list--large .payment-icon {
    height: 30px;
    width: auto;
  }

  .payment-icons-block--grayscale .payment-icon {
    filter: grayscale(100%);
    opacity: 0.75;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }

  .payment-icons-block--grayscale .payment-icon:hover {
    filter: grayscale(0%);
    opacity: 1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Payment methods",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Guaranteed Safe Checkout",
      "info": "Optional title displayed above payment method icons."
    },
    {
      "type": "checkbox",
      "id": "show_lock_icon",
      "label": "Show security lock icon",
      "default": true
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "icon_size",
      "label": "Icon size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "color_mode",
      "label": "Color mode",
      "options": [
        {
          "value": "color",
          "label": "Full color"
        },
        {
          "value": "grayscale",
          "label": "Monochrome / Grayscale"
        }
      ],
      "default": "color"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between icons",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Payment methods"
    }
  ]
}
{% endschema %}
