{% doc %}
  Form Text Area Block
  Renders a multiline text area for messages, comments, and long-form responses.
{% enddoc %}

{% render 'custom-form-styles' %}

{%- liquid
  assign block_settings = block.settings
  assign field_id = 'FormField-Textarea-' | append: block.id
  assign raw_name = block_settings.name | default: 'body'
  assign name_type = block_settings.name_type | default: 'contact'

  case name_type
    when 'contact'
      if raw_name contains 'contact['
        assign field_name = raw_name
      else
        assign field_name = 'contact[' | append: raw_name | append: ']'
      endif
    when 'property'
      if raw_name contains 'properties['
        assign field_name = raw_name
      else
        assign field_name = 'properties[' | append: raw_name | append: ']'
      endif
    when 'attribute'
      if raw_name contains 'attributes['
        assign field_name = raw_name
      else
        assign field_name = 'attributes[' | append: raw_name | append: ']'
      endif
    when 'custom'
      assign field_name = raw_name
  endcase

  assign field_label = block_settings.label | default: 'Message'
  assign field_width = block_settings.width | default: '100'
  assign rows = block_settings.rows | default: 4
  assign help_id = 'FormField-Help-' | append: block.id
  assign max_chars = block_settings.max_characters | default: 0
  assign min_height = block_settings.min_height | default: 100

  assign field_value = block_settings.default_value
-%}

<div
  class="custom-form__field custom-form__field--width-{{ field_width }} spacing-style"
  style="
    --form-textarea-min-height: {{ min_height }}px;
    {% render 'spacing-style', settings: block_settings %}
    {% if block_settings.override_colors %}
      {% if block_settings.input_background_color != blank %}--color-input-background: {{ block_settings.input_background_color }};{% endif %}
      {% if block_settings.input_text_color != blank %}--color-input-text: {{ block_settings.input_text_color }};{% endif %}
      {% if block_settings.input_border_color != blank %}--color-input-border: {{ block_settings.input_border_color }};{% endif %}
      {% if block_settings.input_border_radius != blank %}--style-border-radius-inputs: {{ block_settings.input_border_radius }}px;{% endif %}
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  <label
    for="{{ field_id }}"
    class="custom-form__label{% if block_settings.hide_label %} visually-hidden{% endif %}"
  >
    {{- field_label -}}
    {%- if block_settings.required -%}
      <span class="custom-form__required-mark" aria-hidden="true">*</span>
    {%- endif -%}
  </label>

  <textarea
    id="{{ field_id }}"
    name="{{ field_name }}"
    rows="{{ rows }}"
    class="custom-form__textarea"
    placeholder="{{ block_settings.placeholder | escape }}"
    {% if block_settings.required %}
      required
      aria-required="true"
    {% endif %}
    {% if max_chars > 0 %}
      maxlength="{{ max_chars }}"
      oninput="const el = document.getElementById('{{ field_id }}-counter'); if(el) el.textContent = this.value.length + ' / {{ max_chars }}';"
    {% endif %}
    {% if block_settings.help_text != blank %}
      aria-describedby="{{ help_id }}"
    {% endif %}
  >{{ field_value | escape }}</textarea>

  <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
    {%- if block_settings.help_text != blank -%}
      <span id="{{ help_id }}" class="custom-form__help-text">
        {{- block_settings.help_text -}}
      </span>
    {%- endif -%}

    {%- if max_chars > 0 and block_settings.show_counter -%}
      <span id="{{ field_id }}-counter" class="custom-form__counter">
        0 / {{ max_chars }}
      </span>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Text area",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "name_type",
      "label": "Field purpose",
      "options": [
        {
          "value": "contact",
          "label": "Contact form (contact[...])"
        },
        {
          "value": "property",
          "label": "Line item property (properties[...])"
        },
        {
          "value": "attribute",
          "label": "Cart attribute (attributes[...])"
        },
        {
          "value": "custom",
          "label": "Custom (no wrapper)"
        }
      ],
      "default": "contact",
      "info": "Contact: for contact/inquiry forms. Line item property: for custom product options (engraving, notes). Cart attribute: for cart-level order notes/instructions. Custom: exact HTML name."
    },
    {
      "type": "text",
      "id": "name",
      "label": "Field name",
      "default": "body",
      "info": "Field key (e.g. body, Special Instructions, or delivery_note). Brackets are added automatically based on purpose."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Message"
    },
    {
      "type": "checkbox",
      "id": "hide_label",
      "label": "Visually hide label",
      "default": false
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "Write your message here..."
    },
    {
      "type": "textarea",
      "id": "default_value",
      "label": "Default text"
    },
    {
      "type": "checkbox",
      "id": "required",
      "label": "Required field",
      "default": false
    },
    {
      "type": "range",
      "id": "rows",
      "label": "Number of rows",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "max_characters",
      "label": "Maximum character limit (0 for unlimited)",
      "min": 0,
      "max": 1000,
      "step": 50,
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_counter",
      "label": "Show character counter",
      "default": true,
      "visible_if": "{{ block.settings.max_characters > 0 }}"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Field width",
      "options": [
        {
          "value": "100",
          "label": "Full width (100%)"
        },
        {
          "value": "75",
          "label": "Three quarters (75%)"
        },
        {
          "value": "50",
          "label": "Half width (50%)"
        },
        {
          "value": "auto",
          "label": "Auto"
        }
      ],
      "default": "100"
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Helper text"
    },
    {
      "type": "header",
      "content": "Custom Styling Override"
    },
    {
      "type": "checkbox",
      "id": "override_colors",
      "label": "Override container styles for this field",
      "default": false
    },
    {
      "type": "color",
      "id": "input_background_color",
      "label": "Background color",
      "visible_if": "{{ block.settings.override_colors }}"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Text color",
      "visible_if": "{{ block.settings.override_colors }}"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Border color",
      "visible_if": "{{ block.settings.override_colors }}"
    },
    {
      "type": "range",
      "id": "input_border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 6,
      "visible_if": "{{ block.settings.override_colors }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Text area",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
