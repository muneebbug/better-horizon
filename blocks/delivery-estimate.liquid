{% doc %}
  Estimated Delivery Date Block
  Can be placed as a theme block on product pages, quick-view modals, or within sections.
{% enddoc %}

{%- liquid
  assign block_settings = block.settings
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign min_handling = block_settings.min_handling_days | default: 1
  assign max_handling = block_settings.max_handling_days | default: 2
  assign min_transit = block_settings.min_transit_days | default: 2
  assign max_transit = block_settings.max_transit_days | default: 4
  assign cutoff = block_settings.cutoff_hour | default: 14
  assign exclude_weekends = block_settings.exclude_weekends
  assign show_countdown = block_settings.show_countdown
  assign show_zip = block_settings.show_zip_estimator
  assign show_icon = block_settings.show_icon
  assign icon_type = block_settings.icon_type | default: 'shipping'
  assign heading_text = block_settings.heading

  assign card_style = block_settings.card_style | default: 'default'
-%}

{%- style -%}
  .delivery-estimate-block--{{ block.id }} {
    {% if card_style == 'custom' %}
      {% if block_settings.background_color != blank %}
        --delivery-card-bg: {{ block_settings.background_color }};
      {% endif %}
      {% if block_settings.border_color != blank %}
        --delivery-card-border: {{ block_settings.border_color }};
      {% endif %}
      {% if block_settings.border_width != blank %}
        --delivery-border-width: {{ block_settings.border_width }}px;
      {% endif %}
      {% if block_settings.border_radius != blank %}
        --delivery-border-radius: {{ block_settings.border_radius }}px;
      {% endif %}
    {% elsif card_style == 'minimal' %}
      --delivery-card-bg: transparent;
      --delivery-card-border: transparent;
      --delivery-border-width: 0px;
    {% elsif card_style == 'outline' %}
      --delivery-card-bg: transparent;
    {% endif %}

    {% if block_settings.icon_size != blank %}
      --delivery-icon-size: {{ block_settings.icon_size }}px;
    {% endif %}
    {% if block_settings.icon_color != blank %}
      --delivery-icon-color: {{ block_settings.icon_color }};
    {% endif %}
    {% if block_settings.heading_color != blank %}
      --delivery-heading-color: {{ block_settings.heading_color }};
    {% endif %}
    {% if block_settings.dates_color != blank %}
      --delivery-dates-color: {{ block_settings.dates_color }};
    {% endif %}
    {% if block_settings.countdown_color != blank %}
      --delivery-cutoff-color: {{ block_settings.countdown_color }};
    {% endif %}
  }
{%- endstyle -%}

<div
  class="delivery-estimate-block delivery-estimate-block--{{ block.id }} spacing-style"
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  {% render 'delivery-estimate',
    min_handling_days: min_handling,
    max_handling_days: max_handling,
    min_transit_days: min_transit,
    max_transit_days: max_transit,
    cutoff_hour: cutoff,
    exclude_weekends: exclude_weekends,
    show_countdown: show_countdown,
    show_zip_estimator: show_zip,
    show_icon: show_icon,
    icon_type: icon_type,
    heading: heading_text,
    context: 'pdp',
    is_block: true
  %}
</div>

{% stylesheet %}
  .delivery-estimate-block {
    display: block;
    width: 100%;
    box-sizing: border-box;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Estimated delivery",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Estimated delivery"
    },
    {
      "type": "header",
      "content": "Handling & processing time"
    },
    {
      "type": "range",
      "id": "min_handling_days",
      "label": "Min handling days",
      "min": 0,
      "max": 7,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "max_handling_days",
      "label": "Max handling days",
      "min": 0,
      "max": 14,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Shipping transit time"
    },
    {
      "type": "range",
      "id": "min_transit_days",
      "label": "Min transit days",
      "min": 1,
      "max": 14,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "max_transit_days",
      "label": "Max transit days",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Order cutoff & schedule"
    },
    {
      "type": "range",
      "id": "cutoff_hour",
      "label": "Daily cutoff hour",
      "info": "Hour of day (in 24-hour format) before which orders are dispatched same day.",
      "min": 0,
      "max": 23,
      "step": 1,
      "unit": ":00",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "exclude_weekends",
      "label": "Exclude weekends from delivery dates",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show order cutoff countdown timer",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_zip_estimator",
      "label": "Show postal code / ZIP estimator",
      "default": true
    },
    {
      "type": "header",
      "content": "Card Style & Appearance"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        {
          "value": "default",
          "label": "Default card"
        },
        {
          "value": "minimal",
          "label": "Minimal (no border / transparent)"
        },
        {
          "value": "outline",
          "label": "Outline only"
        },
        {
          "value": "custom",
          "label": "Custom colors"
        }
      ],
      "default": "default"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Card background color",
      "visible_if": "{{ block.settings.card_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border color",
      "visible_if": "{{ block.settings.card_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.card_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ block.settings.card_style == \"custom\" }}"
    },
    {
      "type": "header",
      "content": "Icon Settings"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show delivery icon",
      "default": true
    },
    {
      "type": "select",
      "id": "icon_type",
      "label": "Icon",
      "options": [
        {
          "value": "shipping",
          "label": "Delivery truck"
        },
        {
          "value": "airplane",
          "label": "Airplane / Express"
        },
        {
          "value": "box",
          "label": "Package box"
        },
        {
          "value": "calendar",
          "label": "Calendar date"
        },
        {
          "value": "clock",
          "label": "Clock / Stopwatch"
        }
      ],
      "default": "shipping"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color"
    },
    {
      "type": "header",
      "content": "Typography & Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "dates_color",
      "label": "Date range highlight color"
    },
    {
      "type": "color",
      "id": "countdown_color",
      "label": "Cutoff countdown text color"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Estimated delivery",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
