{% liquid
  assign block_settings = block.settings
  assign ratio = 1

  case block_settings.image_ratio
    when 'landscape'
      assign ratio = '16 / 9'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'square'
      assign ratio = '1 / 1'
    when 'adapt'
      assign ratio = block_settings.image.aspect_ratio
  endcase

  if ratio == 0 or ratio == null
    assign ratio = 1
  endif
%}

{% capture class %}
  image-block image-block--{{ block.id }} image-block--height-{{ block_settings.height }} image-block--fit-{{ block_settings.object_fit | default: 'cover' }}{% if block_settings.grayscale != blank and block_settings.grayscale != 'none' %} image-block--grayscale-{{ block_settings.grayscale }}{% endif %}{% if block_settings.hover_effect != blank and block_settings.hover_effect != 'none' %} image-block--hover-{{ block_settings.hover_effect }}{% endif %} spacing-style size-style
{% endcapture %}

{% capture style %}
  {% if block_settings.object_fit != 'contain' %}
    --ratio: {{ ratio }};
  {% endif %}
  {% if block_settings.max_height > 0 %}
    --image-max-height: {{ block_settings.max_height }}px;
  {% endif %}
  {% if block_settings.max_height_mobile > 0 %}
    --image-max-height-mobile: {{ block_settings.max_height_mobile }}px;
  {% endif %}
  {% if block_settings.max_width_px > 0 %}
    --image-max-width-px: {{ block_settings.max_width_px }}px;
  {% endif %}
  {% if block_settings.opacity != blank and block_settings.opacity < 100 %}
    --image-opacity: {{ block_settings.opacity | divided_by: 100.0 }};
  {% endif %}
  {% if block_settings.hover_opacity != blank and block_settings.hover_opacity < 100 %}
    --image-hover-opacity: {{ block_settings.hover_opacity | divided_by: 100.0 }};
  {% endif %}
  {% render 'size-style', settings: block_settings %}
  {% render 'spacing-style', settings: block_settings %}
{% endcapture %}

{% capture image_border_style %}
  {% if block_settings.object_fit != 'contain' %}
    --ratio: {{ ratio }};
  {% endif %}
  {% render 'border-override', settings: block_settings %}
{% endcapture %}

{% liquid
  assign media_width_desktop = '100vw'
  assign media_width_mobile = '100vw'
  assign sizes = 'auto, (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '240, 352, 832, 1200, 1600, 1920, 2560, 3840'
%}

{% capture image %}
  {%- if block_settings.image -%}
    {{
      block_settings.image
      | image_url: width: 3840
      | image_tag:
        width: block_settings.image.width,
        widths: widths,
        height: block_settings.image.height,
        class: 'image-block__image border-style',
        style: image_border_style,
        sizes: sizes
    }}
  {%- else -%}
    <div class="placeholder-image border-style size-style" style="{{ image_border_style }}">
      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'image-block__placeholder' }}
    </div>
  {%- endif -%}
{% endcapture %}

{% if block_settings.link == blank %}
  <div
    class="{{ class }}"
    style="{{ style }}"
    {{ block.shopify_attributes }}
  >
    {{ image }}
  </div>
{% else %}
  <a
    href="{{ block_settings.link }}"
    class="{{ class }}"
    style="{{ style }}"
    {{ block.shopify_attributes }}
  >
    {{ image }}
  </a>
{% endif %}

{% stylesheet %}
  .image-block__placeholder {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center center;
    overflow: hidden;
    position: relative;
  }

  .placeholder-image {
    position: relative;
    overflow: hidden;
  }

  .image-block {
    display: flex;
    justify-content: var(--horizontal-alignment, 'inline-start');
    max-height: var(--image-max-height, none);
    max-width: var(--image-max-width-px, none);
    opacity: var(--image-opacity, 1);
    transition: opacity 0.2s ease, transform 0.2s ease, filter 0.2s ease;
    text-decoration: none;
    box-sizing: border-box;
    align-items: center;
  }

  .image-block:hover {
    opacity: var(--image-hover-opacity, var(--image-opacity, 1));
  }

  .image-block--height-fill .image-block__image {
    height: 100%;
  }

  .image-block--fit-cover .placeholder-image {
    aspect-ratio: var(--ratio);
  }

  .image-block--fit-cover .image-block__image {
    object-fit: cover;
    aspect-ratio: var(--ratio);
    max-height: var(--image-max-height, none);
    max-width: var(--image-max-width-px, 100%);
  }

  .image-block--fit-contain {
    align-items: center;
  }

  .image-block--fit-contain .image-block__image {
    object-fit: contain;
    max-height: var(--image-max-height, none);
    max-width: var(--image-max-width-px, 100%);
    width: auto;
    height: auto;
  }

  .image-block--fit-contain .placeholder-image {
    max-height: var(--image-max-height, none);
    width: 100%;
  }

  .image-block--grayscale-always {
    filter: grayscale(100%);
  }

  .image-block--grayscale-hover {
    filter: grayscale(100%);
  }

  .image-block--grayscale-hover:hover {
    filter: grayscale(0%);
  }

  .image-block--hover-scale:hover {
    transform: scale(1.06);
  }

  .image-block--hover-lift:hover {
    transform: translateY(-3px);
  }

  @media screen and (max-width: 749px) {
    .image-block {
      max-height: var(--image-max-height-mobile, var(--image-max-height, none));
    }

    .image-block--fit-contain .image-block__image {
      max-height: var(--image-max-height-mobile, var(--image-max-height, none));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .image-block {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "object_fit",
      "label": "Image fit mode",
      "options": [
        {
          "value": "cover",
          "label": "Cover (Fill area)"
        },
        {
          "value": "contain",
          "label": "Contain (Preserve logo / icon size)"
        }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "max_height",
      "label": "Max height (px)",
      "info": "Useful for brand logos, icons, and badges. Set to 0 for auto.",
      "min": 0,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "max_height_mobile",
      "label": "Max height on mobile (px)",
      "info": "Set to 0 to inherit desktop max height.",
      "min": 0,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "max_width_px",
      "label": "Max width (px)",
      "info": "Set to 0 for no limit.",
      "min": 0,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "adapt",
      "visible_if": "{{ block.settings.object_fit == 'cover' }}"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "fit",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        }
      ],
      "default": "fit",
      "visible_if": "{{ block.settings.image_ratio == 'adapt' and block.settings.object_fit == 'cover' }}"
    },
    {
      "type": "header",
      "content": "Appearance & Effects"
    },
    {
      "type": "range",
      "id": "opacity",
      "label": "Opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "hover_opacity",
      "label": "Hover opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "grayscale",
      "label": "Grayscale filter",
      "options": [
        {
          "value": "none",
          "label": "None (Full color)"
        },
        {
          "value": "always",
          "label": "Always grayscale"
        },
        {
          "value": "hover",
          "label": "Grayscale (Color on hover)"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "Hover animation",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade opacity"
        },
        {
          "value": "scale",
          "label": "Subtle scale"
        },
        {
          "value": "lift",
          "label": "Lift upward"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.image",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
