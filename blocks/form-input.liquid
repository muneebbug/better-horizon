{% doc %}
  Form Input Block
  Renders a customizable single-line input field (text, email, tel, number, url, etc.) for custom forms.
{% enddoc %}

{% render 'custom-form-styles' %}

{%- liquid
  assign block_settings = block.settings
  assign field_id = 'FormField-Input-' | append: block.id
  assign field_type = block_settings.type | default: 'text'
  assign raw_name = block_settings.name | default: 'name'
  assign name_type = block_settings.name_type | default: 'contact'

  case name_type
    when 'contact'
      if raw_name contains 'contact['
        assign field_name = raw_name
      else
        assign field_name = 'contact[' | append: raw_name | append: ']'
      endif
    when 'property'
      if raw_name contains 'properties['
        assign field_name = raw_name
      else
        assign field_name = 'properties[' | append: raw_name | append: ']'
      endif
    when 'attribute'
      if raw_name contains 'attributes['
        assign field_name = raw_name
      else
        assign field_name = 'attributes[' | append: raw_name | append: ']'
      endif
    when 'custom'
      assign field_name = raw_name
  endcase

  assign field_label = block_settings.label | default: 'Name'
  assign field_width = block_settings.width | default: '100'
  assign help_id = 'FormField-Help-' | append: block.id
  assign icon = block_settings.icon | default: 'none'

  assign field_value = block_settings.default_value
  if field_name == 'contact[name]' and customer
    assign field_value = customer.name
  elsif field_name == 'contact[email]' and customer
    assign field_value = customer.email
  elsif field_name == 'contact[phone]' and customer
    assign field_value = customer.phone
  endif
-%}

{%- if field_type == 'hidden' -%}
  <input
    type="hidden"
    name="{{ field_name }}"
    value="{{ field_value | escape }}"
    {{ block.shopify_attributes }}
  >
{%- else -%}
  <div
    class="custom-form__field custom-form__field--width-{{ field_width }} spacing-style"
    style="
      {% render 'spacing-style', settings: block_settings %}
      {% if block_settings.override_colors %}
        {% if block_settings.input_background_color != blank %}--color-input-background: {{ block_settings.input_background_color }};{% endif %}
        {% if block_settings.input_text_color != blank %}--color-input-text: {{ block_settings.input_text_color }};{% endif %}
        {% if block_settings.input_border_color != blank %}--color-input-border: {{ block_settings.input_border_color }};{% endif %}
        {% if block_settings.input_border_radius != blank %}--style-border-radius-inputs: {{ block_settings.input_border_radius }}px;{% endif %}
      {% endif %}
    "
    {{ block.shopify_attributes }}
  >
    <label
      for="{{ field_id }}"
      class="custom-form__label{% if block_settings.hide_label %} visually-hidden{% endif %}"
    >
      {{- field_label -}}
      {%- if block_settings.required -%}
        <span class="custom-form__required-mark" aria-hidden="true">*</span>
      {%- endif -%}
    </label>

    <div class="custom-form__input-wrapper{% if icon != 'none' and icon != blank %} custom-form__input-wrapper--has-icon{% endif %}">
      {%- if icon != 'none' and icon != blank -%}
        <span class="custom-form__input-icon" aria-hidden="true">
          {%- case icon -%}
            {%- when 'user' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            {%- when 'email' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            {%- when 'phone' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            {%- when 'calendar' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            {%- when 'lock' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            {%- when 'globe' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" x2="22" y1="12" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            {%- when 'search' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/></svg>
            {%- when 'hash' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="9" y2="9"/><line x1="4" x2="20" y1="15" y2="15"/><line x1="10" x2="8" y1="3" y2="21"/><line x1="16" x2="14" y1="3" y2="21"/></svg>
          {%- endcase -%}
        </span>
      {%- endif -%}

      <input
        type="{{ field_type }}"
        id="{{ field_id }}"
        name="{{ field_name }}"
        class="custom-form__input"
        value="{{ field_value | escape }}"
        placeholder="{{ block_settings.placeholder | escape }}"
        {% if block_settings.required %}
          required
          aria-required="true"
        {% endif %}
        {% if block_settings.autocomplete != 'off' and block_settings.autocomplete != blank %}
          autocomplete="{{ block_settings.autocomplete }}"
        {% endif %}
        {% if block_settings.help_text != blank %}
          aria-describedby="{{ help_id }}"
        {% endif %}
      >
    </div>

    {%- if block_settings.help_text != blank -%}
      <span id="{{ help_id }}" class="custom-form__help-text">
        {{- block_settings.help_text -}}
      </span>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Input field",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "type",
      "label": "Input type",
      "options": [
        {
          "value": "text",
          "label": "Text"
        },
        {
          "value": "email",
          "label": "Email"
        },
        {
          "value": "tel",
          "label": "Phone"
        },
        {
          "value": "number",
          "label": "Number"
        },
        {
          "value": "url",
          "label": "URL"
        },
        {
          "value": "date",
          "label": "Date"
        },
        {
          "value": "time",
          "label": "Time"
        },
        {
          "value": "password",
          "label": "Password"
        },
        {
          "value": "hidden",
          "label": "Hidden"
        }
      ],
      "default": "text"
    },
    {
      "type": "select",
      "id": "name_type",
      "label": "Field purpose",
      "options": [
        {
          "value": "contact",
          "label": "Contact form (contact[...])"
        },
        {
          "value": "property",
          "label": "Line item property (properties[...])"
        },
        {
          "value": "attribute",
          "label": "Cart attribute (attributes[...])"
        },
        {
          "value": "custom",
          "label": "Custom (no wrapper)"
        }
      ],
      "default": "contact",
      "info": "Contact: for contact/inquiry forms. Line item property: for custom product options (engraving, size). Cart attribute: for cart-level order notes/instructions. Custom: exact HTML name."
    },
    {
      "type": "text",
      "id": "name",
      "label": "Field name",
      "default": "name",
      "info": "Field key (e.g. name, email, Engraving, or delivery_note). Brackets are added automatically based on purpose."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Name"
    },
    {
      "type": "checkbox",
      "id": "hide_label",
      "label": "Visually hide label",
      "default": false
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "Enter your name..."
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Leading icon",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "user",
          "label": "User profile"
        },
        {
          "value": "email",
          "label": "Email envelope"
        },
        {
          "value": "phone",
          "label": "Phone"
        },
        {
          "value": "calendar",
          "label": "Calendar date"
        },
        {
          "value": "lock",
          "label": "Security lock"
        },
        {
          "value": "globe",
          "label": "Globe / Web"
        },
        {
          "value": "search",
          "label": "Search glass"
        },
        {
          "value": "hash",
          "label": "Hash / Number"
        }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "default_value",
      "label": "Default value"
    },
    {
      "type": "checkbox",
      "id": "required",
      "label": "Required field",
      "default": false
    },
    {
      "type": "select",
      "id": "width",
      "label": "Field width",
      "options": [
        {
          "value": "100",
          "label": "Full width (100%)"
        },
        {
          "value": "75",
          "label": "Three quarters (75%)"
        },
        {
          "value": "50",
          "label": "Half width (50%)"
        },
        {
          "value": "33",
          "label": "One third (33%)"
        },
        {
          "value": "25",
          "label": "One quarter (25%)"
        },
        {
          "value": "auto",
          "label": "Auto"
        }
      ],
      "default": "100"
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Helper text"
    },
    {
      "type": "select",
      "id": "autocomplete",
      "label": "Browser autocomplete",
      "options": [
        {
          "value": "off",
          "label": "Off"
        },
        {
          "value": "name",
          "label": "Full name"
        },
        {
          "value": "given-name",
          "label": "First name"
        },
        {
          "value": "family-name",
          "label": "Last name"
        },
        {
          "value": "email",
          "label": "Email"
        },
        {
          "value": "tel",
          "label": "Phone"
        },
        {
          "value": "organization",
          "label": "Company name"
        },
        {
          "value": "street-address",
          "label": "Street address"
        },
        {
          "value": "postal-code",
          "label": "Postal / ZIP code"
        },
        {
          "value": "country-name",
          "label": "Country"
        }
      ],
      "default": "off"
    },
    {
      "type": "header",
      "content": "Custom Styling Override"
    },
    {
      "type": "checkbox",
      "id": "override_colors",
      "label": "Override container styles for this field",
      "default": false
    },
    {
      "type": "color",
      "id": "input_background_color",
      "label": "Background color",
      "visible_if": "{{ block.settings.override_colors }}"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Text color",
      "visible_if": "{{ block.settings.override_colors }}"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Border color",
      "visible_if": "{{ block.settings.override_colors }}"
    },
    {
      "type": "range",
      "id": "input_border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 6,
      "visible_if": "{{ block.settings.override_colors }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Input field",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
