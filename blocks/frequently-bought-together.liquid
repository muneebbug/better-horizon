{% doc %}
  Frequently Bought Together / Bundle Recommendations Block
  Renders the main product along with complementary items in a clean, high-converting list layout.
{% enddoc %}

{%- liquid
  assign block_settings = block.settings
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign max_items = block_settings.products_to_show | default: 2

  assign bundle_products = product.metafields.custom.bundle_products.value
  if bundle_products == blank or bundle_products.size == 0
    if block_settings.products != blank
      assign bundle_products = block_settings.products
    else
      assign bundle_collection = product.collections.first | default: collections.all
      assign bundle_products = bundle_collection.products
    endif
  endif

  assign show_currency = settings.currency_code_enabled_product_pages
  if show_currency
    assign money_format = shop.money_with_currency_format
  else
    assign money_format = shop.money_format
  endif

  assign main_variant = product.selected_or_first_available_variant
  assign bundle_total_cents = main_variant.price | default: 0

  assign card_style = block_settings.card_style | default: 'default'
  assign image_size = block_settings.image_size | default: 64
  assign image_radius = block_settings.image_border_radius | default: 6
  assign gap_size = block_settings.gap | default: 12
  assign button_style = block_settings.button_style | default: 'primary'
-%}

{%- style -%}
  .bundle-block--{{ block.id }} {
    {% if card_style == 'custom' %}
      {% if block_settings.background_color != blank %}
        --bundle-bg: {{ block_settings.background_color }};
      {% endif %}
      {% if block_settings.border_color != blank %}
        --bundle-border: {{ block_settings.border_color }};
      {% endif %}
      {% if block_settings.border_width != blank %}
        --bundle-border-width: {{ block_settings.border_width }}px;
      {% endif %}
      {% if block_settings.border_radius != blank %}
        --bundle-border-radius: {{ block_settings.border_radius }}px;
      {% endif %}
    {% elsif card_style == 'minimal' %}
      --bundle-bg: transparent;
      --bundle-border: transparent;
      --bundle-border-width: 0px;
    {% elsif card_style == 'outline' %}
      --bundle-bg: transparent;
    {% endif %}

    --bundle-img-size: {{ image_size }}px;
    --bundle-img-radius: {{ image_radius }}px;
    --bundle-gap: {{ gap_size }}px;

    {% if block_settings.heading_color != blank %}
      --bundle-heading-color: {{ block_settings.heading_color }};
    {% endif %}
    {% if block_settings.product_title_color != blank %}
      --bundle-title-color: {{ block_settings.product_title_color }};
    {% endif %}
    {% if block_settings.price_color != blank %}
      --bundle-price-color: {{ block_settings.price_color }};
    {% endif %}
    {% if block_settings.total_price_color != blank %}
      --bundle-total-color: {{ block_settings.total_price_color }};
    {% endif %}
  }

  {% if button_style == 'custom' %}
    .bundle-block--{{ block.id }} .bundle-block__button {
      {% if block_settings.button_background_color != blank %}
        background-color: {{ block_settings.button_background_color }};
      {% endif %}
      {% if block_settings.button_text_color != blank %}
        color: {{ block_settings.button_text_color }};
      {% endif %}
      {% if block_settings.button_border_color != blank %}
        border-color: {{ block_settings.button_border_color }};
      {% endif %}
      {% if block_settings.button_border_radius != blank %}
        border-radius: {{ block_settings.button_border_radius }}px;
      {% endif %}
    }
  {% endif %}
{%- endstyle -%}

<script
  src="{{ 'bundle-recommendations.js' | asset_url }}"
  defer
  type="module"
></script>

<div
  class="bundle-block bundle-block--{{ block.id }} spacing-style"
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  <bundle-recommendations
    class="bundle-recommendations"
    data-product-id="{{ product.id }}"
    data-section-id="{{ section.id }}"
    data-money-format="{{ money_format | escape }}"
    data-currency="{{ cart.currency.iso_code }}"
    data-button-text="{{ block_settings.button_label | default: 'Add Bundle to Cart' }}"
  >
    {%- if block_settings.heading != blank -%}
      <h3 class="bundle-block__title">{{ block_settings.heading }}</h3>
    {%- endif -%}

    <div class="bundle-block__items" data-bundle-items>
      {%- comment -%} Main Product Item {%- endcomment -%}
      {%- assign main_image = main_variant.featured_image | default: product.featured_image -%}
      <div class="bundle-item bundle-item--main" data-product-id="{{ product.id }}">
        <label class="bundle-item__checkbox-label">
          <input
            type="checkbox"
            checked
            disabled
            data-variant-id="{{ main_variant.id }}"
            data-price-cents="{{ main_variant.price }}"
            class="bundle-item__checkbox"
            aria-label="{{ product.title | escape }}"
          >
          <span class="bundle-item__badge">This item:</span>
        </label>
        {%- if main_image -%}
          <img
            src="{{ main_image | image_url: width: 160 }}"
            alt="{{ main_image.alt | default: product.title | escape }}"
            class="bundle-item__image"
            width="{{ image_size }}"
            height="{{ image_size }}"
            loading="lazy"
          >
        {%- endif -%}
        <div class="bundle-item__info">
          <span class="bundle-item__title">{{ product.title }}</span>
          <span class="bundle-item__price" data-item-price>{{ main_variant.price | money }}</span>

          {%- if product.variants.size > 1 -%}
            <div class="bundle-item__select-wrapper">
              <select
                class="bundle-item__variant-select"
                data-bundle-variant-select
                aria-label="{{ product.title | escape }} {{ 'content.variant' | t | default: 'Variant' }}"
              >
                {%- for variant in product.variants -%}
                  <option
                    value="{{ variant.id }}"
                    data-price-cents="{{ variant.price }}"
                    data-options="{{ variant.options | join: '|||' | escape }}"
                    {% if variant.featured_image %}
                      data-image="{{ variant.featured_image | image_url: width: 160 }}"
                    {% endif %}
                    {% if variant.id == main_variant.id %}
                      selected
                    {% endif %}
                    {% unless variant.available %}
                      disabled
                      class="is-unavailable"
                    {% endunless %}
                  >
                    {{ variant.title }}{% unless variant.available %} - {{ 'content.product_badge_sold_out' | t | default: 'Sold out' }}{% endunless %}
                  </option>
                {%- endfor -%}
              </select>
              <span class="svg-wrapper bundle-item__select-caret">
                {{ 'icon-caret.svg' | inline_asset_content }}
              </span>
              <script type="application/json" data-product-variants>
                {{ product.variants | json }}
              </script>
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Complementary Items {%- endcomment -%}
      {%- assign rendered_count = 0 -%}
      {%- if bundle_products != blank -%}
        {%- for rec_product in bundle_products -%}
          {%- if rendered_count >= max_items -%}
            {%- break -%}
          {%- endif -%}
          {%- if rec_product.id != product.id and rec_product.available -%}
            {%- assign rec_variant = rec_product.selected_or_first_available_variant -%}
            {%- if rec_variant -%}
              {%- assign rendered_count = rendered_count | plus: 1 -%}
              {%- assign bundle_total_cents = bundle_total_cents | plus: rec_variant.price -%}
              {%- assign rec_image = rec_variant.featured_image | default: rec_product.featured_image -%}
              <div class="bundle-item" data-product-id="{{ rec_product.id }}">
                <label class="bundle-item__checkbox-label">
                  <input
                    type="checkbox"
                    checked
                    data-variant-id="{{ rec_variant.id }}"
                    data-price-cents="{{ rec_variant.price }}"
                    class="bundle-item__checkbox"
                    aria-label="{{ rec_product.title | escape }}"
                  >
                </label>
                {%- if rec_image -%}
                  <img
                    src="{{ rec_image | image_url: width: 160 }}"
                    alt="{{ rec_image.alt | default: rec_product.title | escape }}"
                    class="bundle-item__image"
                    width="{{ image_size }}"
                    height="{{ image_size }}"
                    loading="lazy"
                  >
                {%- endif -%}
                <div class="bundle-item__info">
                  <a href="{{ rec_product.url }}" class="bundle-item__title">{{ rec_product.title }}</a>
                  <span class="bundle-item__price" data-item-price>{{ rec_variant.price | money }}</span>

                  {%- if rec_product.variants.size > 1 -%}
                    <div class="bundle-item__select-wrapper">
                      <select
                        class="bundle-item__variant-select"
                        data-bundle-variant-select
                        aria-label="{{ rec_product.title | escape }} {{ 'content.variant' | t | default: 'Variant' }}"
                      >
                        {%- for variant in rec_product.variants -%}
                          <option
                            value="{{ variant.id }}"
                            data-price-cents="{{ variant.price }}"
                            {% if variant.featured_image %}
                              data-image="{{ variant.featured_image | image_url: width: 160 }}"
                            {% endif %}
                            {% if variant.id == rec_variant.id %}
                              selected
                            {% endif %}
                            {% unless variant.available %}
                              disabled
                              class="is-unavailable"
                            {% endunless %}
                          >
                            {{ variant.title }}{% unless variant.available %} - {{ 'content.product_badge_sold_out' | t | default: 'Sold out' }}{% endunless %}
                          </option>
                        {%- endfor -%}
                      </select>
                      <span class="svg-wrapper bundle-item__select-caret">
                        {{ 'icon-caret.svg' | inline_asset_content }}
                      </span>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if rendered_count == 0 and request.design_mode -%}
        <p class="bundle-item__empty-note">
          No complementary items found. Choose fallback products below or configure the custom.bundle_products metafield.
        </p>
      {%- endif -%}
    </div>

    <div class="bundle-block__footer">
      <div class="bundle-block__total">
        <span>Total Price:</span>
        <strong data-bundle-total class="bundle-block__total-price">{{ bundle_total_cents | money }}</strong>
      </div>
      <button
        type="button"
        class="button bundle-block__button button--{{ button_style }}"
        data-bundle-add-button
      >
        {{ block_settings.button_label | default: 'Add Bundle to Cart' }}
      </button>
    </div>
  </bundle-recommendations>
</div>

{% stylesheet %}
  .bundle-block {
    margin: 0;
    padding: var(--padding-lg, 20px);
    border: var(--bundle-border-width, 1px) solid var(--bundle-border, rgb(var(--color-foreground-rgb) / 0.15));
    border-radius: var(--bundle-border-radius, var(--style-border-radius-inputs, 8px));
    background-color: var(--bundle-bg, rgb(var(--color-foreground-rgb) / 0.03));
    color: var(--color-foreground);
    box-sizing: border-box;
    width: 100%;
  }

  .bundle-block__title {
    margin: 0 0 var(--margin-md, 16px) 0;
    font-size: var(--font-body--size, 15px);
    font-weight: 600;
    color: var(--bundle-heading-color, var(--color-foreground));
    line-height: 1.3;
  }

  .bundle-block__items {
    display: flex;
    flex-direction: column;
    gap: var(--bundle-gap, 12px);
    margin-bottom: var(--margin-md, 16px);
  }

  .bundle-item {
    display: flex;
    align-items: center;
    gap: var(--gap-sm, 12px);
  }

  .bundle-item__checkbox-label {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    flex-shrink: 0;
  }

  .bundle-item__checkbox {
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: var(--color-foreground);
    margin: 0;
  }

  .bundle-item__badge {
    font-size: 0.8em;
    font-weight: 600;
    margin-left: 6px;
    color: var(--color-foreground);
    white-space: nowrap;
  }

  .bundle-item__image {
    width: var(--bundle-img-size, 64px);
    height: var(--bundle-img-size, 64px);
    object-fit: cover;
    border-radius: var(--bundle-img-radius, 6px);
    flex-shrink: 0;
  }

  .bundle-item__info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    flex-grow: 1;
  }

  .bundle-item__title {
    font-size: var(--font-body--size, 14px);
    font-weight: 500;
    text-decoration: none;
    color: var(--bundle-title-color, var(--color-foreground));
    line-height: 1.35;
    word-break: break-word;
  }

  .bundle-item__title:hover {
    text-decoration: underline;
  }

  .bundle-item__price {
    font-size: var(--font-body--size, 13px);
    color: var(--bundle-price-color, var(--color-foreground-subdued, rgb(var(--color-foreground-rgb) / 0.7)));
    font-weight: 500;
  }

  .bundle-item__select-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    max-width: 220px;
    width: 100%;
    margin-top: 4px;
  }

  .bundle-item__variant-select {
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    padding: 6px 28px 6px 10px;
    font-size: calc(var(--font-body--size, 14px) * 0.88);
    line-height: 1.3;
    color: var(--color-foreground);
    background-color: var(--color-input-background, var(--color-background));
    border: var(--style-border-width, 1px) solid rgb(var(--color-foreground-rgb) / 0.2);
    border-radius: var(--style-border-radius-inputs, 6px);
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .bundle-item__variant-select:focus-visible {
    outline: none;
    border-color: var(--color-foreground);
    box-shadow: 0 0 0 1px var(--color-foreground);
  }

  .bundle-item__variant-select option[disabled],
  .bundle-item__variant-select option:disabled,
  .bundle-item__variant-select .is-unavailable {
    color: rgb(var(--color-foreground-rgb) / 0.4);
    text-decoration: line-through;
  }

  .bundle-item__select-caret {
    position: absolute;
    right: 8px;
    pointer-events: none;
    width: 12px;
    height: 12px;
    color: var(--color-foreground);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bundle-item__select-caret svg {
    width: 10px;
    height: 10px;
  }

  .bundle-item__empty-note {
    font-size: var(--font-body--size, 13px);
    color: var(--color-foreground-subdued, rgb(var(--color-foreground-rgb) / 0.7));
    margin: 0;
    font-style: italic;
  }

  .bundle-block__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--padding-md, 14px);
    border-top: var(--bundle-border-width, 1px) solid var(--bundle-border, rgb(var(--color-foreground-rgb) / 0.15));
    flex-wrap: wrap;
    gap: var(--gap-sm, 12px);
  }

  .bundle-block__total {
    font-size: var(--font-body--size, 14px);
    display: flex;
    gap: 6px;
    align-items: baseline;
    color: var(--color-foreground);
  }

  .bundle-block__total-price {
    font-size: 1.15em;
    font-weight: 700;
    color: var(--bundle-total-color, var(--color-foreground));
  }

  .bundle-block__button {
    min-height: var(--height-buy-buttons, 44px);
    padding: 0 var(--padding-xl, 20px);
    cursor: pointer;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease, transform 0.1s ease;
  }

  .bundle-block__button:hover {
    opacity: 0.9;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Frequently bought",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Display complementary products in a bundle with real-time price updates and one-click add to cart."
    },
    {
      "type": "header",
      "content": "Content & Headings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Bought Together"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add Bundle to Cart"
    },
    {
      "type": "header",
      "content": "Sizing & Spacing"
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Product thumbnail size",
      "min": 48,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Product thumbnail corner radius",
      "min": 0,
      "max": 16,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Spacing between bundle items",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Card Style & Colors"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Container style",
      "options": [
        {
          "value": "default",
          "label": "Default card"
        },
        {
          "value": "minimal",
          "label": "Minimal (borderless / transparent)"
        },
        {
          "value": "outline",
          "label": "Outline only"
        },
        {
          "value": "custom",
          "label": "Custom colors"
        }
      ],
      "default": "default"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "visible_if": "{{ block.settings.card_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "visible_if": "{{ block.settings.card_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.card_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Container corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ block.settings.card_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Product title color"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Item price color"
    },
    {
      "type": "color",
      "id": "total_price_color",
      "label": "Total bundle price color"
    },
    {
      "type": "header",
      "content": "Button Styling"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style preset",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "primary"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Custom button background",
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Custom button text color",
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Custom button border color",
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "header",
      "content": "Product Recommendations"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Fallback products",
      "limit": 4,
      "info": "Choose default products to bundle when a product has no custom bundle metafield assigned."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Items to show",
      "default": 2
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Frequently bought together",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
