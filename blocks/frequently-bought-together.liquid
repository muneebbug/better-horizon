{% doc %}
  Frequently Bought Together / Bundle Recommendations Block
  Renders the main product along with complementary items to encourage multi-item purchases.
{% enddoc %}

{%- liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign currency_symbol = cart.currency.symbol | default: '$'
-%}

<script
  src="{{ 'bundle-recommendations.js' | asset_url }}"
  defer
  type="module"
></script>

<div
  class="bundle-block bundle-block--{{ block.id }}"
  {{ block.shopify_attributes }}
>
  <bundle-recommendations
    class="bundle-recommendations"
    data-product-id="{{ product.id }}"
    data-section-id="{{ section.id }}"
    data-currency-symbol="{{ currency_symbol }}"
    data-button-text="{{ block.settings.button_label }}"
  >
    <h3 class="bundle-block__title">{{ block.settings.heading }}</h3>

    <div class="bundle-block__grid" data-bundle-items>
      {%- comment -%} Main Product Item {%- endcomment -%}
      {%- assign main_variant = product.selected_or_first_available_variant -%}
      <div class="bundle-item">
        <label class="bundle-item__checkbox-label">
          <input
            type="checkbox"
            checked
            disabled
            data-variant-id="{{ main_variant.id }}"
            data-price-cents="{{ main_variant.price }}"
            class="bundle-item__checkbox"
          >
          <span class="bundle-item__badge">This item:</span>
        </label>
        {%- if product.featured_image -%}
          <img
            src="{{ product.featured_image | image_url: width: 140 }}"
            alt="{{ product.title | escape }}"
            class="bundle-item__image"
            width="70"
            height="70"
            loading="lazy"
          >
        {%- endif -%}
        <div class="bundle-item__info">
          <span class="bundle-item__title">{{ product.title }}</span>
          <span class="bundle-item__price">{{ main_variant.price | money }}</span>
        </div>
      </div>

      {%- comment -%} Recommendations or Curated Metafield Products {%- endcomment -%}
      {%- assign bundle_products = product.metafields.custom.bundle_products.value -%}
      {%- if bundle_products != blank -%}
        {%- for rec_product in bundle_products limit: 2 -%}
          {%- assign rec_variant = rec_product.selected_or_first_available_variant -%}
          {%- if rec_variant and rec_variant.available -%}
            <div class="bundle-item">
              <label class="bundle-item__checkbox-label">
                <input
                  type="checkbox"
                  checked
                  data-variant-id="{{ rec_variant.id }}"
                  data-price-cents="{{ rec_variant.price }}"
                  class="bundle-item__checkbox"
                >
              </label>
              {%- if rec_product.featured_image -%}
                <img
                  src="{{ rec_product.featured_image | image_url: width: 140 }}"
                  alt="{{ rec_product.title | escape }}"
                  class="bundle-item__image"
                  width="70"
                  height="70"
                  loading="lazy"
                >
              {%- endif -%}
              <div class="bundle-item__info">
                <a href="{{ rec_product.url }}" class="bundle-item__title">{{ rec_product.title }}</a>
                <span class="bundle-item__price">{{ rec_variant.price | money }}</span>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- elsif collections.all.products.size > 1 -%}
        {%- for rec_product in collections.all.products limit: 2 -%}
          {%- unless rec_product.id == product.id -%}
            {%- assign rec_variant = rec_product.selected_or_first_available_variant -%}
            {%- if rec_variant and rec_variant.available -%}
              <div class="bundle-item">
                <label class="bundle-item__checkbox-label">
                  <input
                    type="checkbox"
                    checked
                    data-variant-id="{{ rec_variant.id }}"
                    data-price-cents="{{ rec_variant.price }}"
                    class="bundle-item__checkbox"
                  >
                </label>
                {%- if rec_product.featured_image -%}
                  <img
                    src="{{ rec_product.featured_image | image_url: width: 140 }}"
                    alt="{{ rec_product.title | escape }}"
                    class="bundle-item__image"
                    width="70"
                    height="70"
                    loading="lazy"
                  >
                {%- endif -%}
                <div class="bundle-item__info">
                  <a href="{{ rec_product.url }}" class="bundle-item__title">{{ rec_product.title }}</a>
                  <span class="bundle-item__price">{{ rec_variant.price | money }}</span>
                </div>
              </div>
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="bundle-block__footer">
      <div class="bundle-block__total">
        <span>Total Price:</span>
        <strong data-bundle-total class="bundle-block__total-price">{{ main_variant.price | money }}</strong>
      </div>
      <button
        type="button"
        class="button bundle-block__button"
        data-bundle-add-button
      >
        {{ block.settings.button_label }}
      </button>
    </div>
  </bundle-recommendations>
</div>

{% stylesheet %}
  .bundle-block {
    margin: 0;
    padding: var(--padding-lg, 20px);
    border: var(--style-border-width, 1px) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25, 0.15));
    border-radius: var(--style-border-radius-inputs, 8px);
    background-color: rgb(var(--color-foreground-rgb) / 0.03);
    color: var(--color-foreground);
  }

  .bundle-block__title {
    margin: 0 0 var(--margin-md, 16px) 0;
    font-size: var(--font-body--size, 15px);
    font-weight: 600;
    color: var(--color-foreground);
  }

  .bundle-block__grid {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md, 12px);
    margin-bottom: var(--margin-md, 16px);
  }

  .bundle-item {
    display: flex;
    align-items: center;
    gap: var(--gap-sm, 12px);
  }

  .bundle-item__checkbox-label {
    display: flex;
    align-items: center;
    cursor: pointer;
  }

  .bundle-item__checkbox {
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: var(--color-foreground);
  }

  .bundle-item__badge {
    font-size: 0.8em;
    font-weight: 600;
    margin-left: 4px;
    color: var(--color-foreground);
  }

  .bundle-item__image {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: var(--style-border-radius-inputs, 6px);
  }

  .bundle-item__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .bundle-item__title {
    font-size: var(--font-body--size, 14px);
    font-weight: 500;
    text-decoration: none;
    color: var(--color-foreground);
  }

  .bundle-item__title:hover {
    text-decoration: underline;
  }

  .bundle-item__price {
    font-size: var(--font-body--size, 13px);
    color: var(--color-foreground-subdued, rgb(var(--color-foreground-rgb) / 0.7));
  }

  .bundle-block__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--padding-md, 14px);
    border-top: var(--style-border-width, 1px) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25, 0.15));
    flex-wrap: wrap;
    gap: var(--gap-sm, 8px);
  }

  .bundle-block__total {
    font-size: var(--font-body--size, 14px);
    display: flex;
    gap: 6px;
    align-items: baseline;
    color: var(--color-foreground);
  }

  .bundle-block__total-price {
    font-size: 1.1em;
    font-weight: 600;
  }

  .bundle-block__button {
    min-height: var(--height-buy-buttons, 44px);
    padding: 0 var(--padding-xl, 20px);
    border-radius: var(--style-border-radius-buttons-primary, 9999px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Frequently bought",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Bought Together"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add Bundle to Cart"
    }
  ],
  "presets": [
    {
      "name": "Frequently bought together"
    }
  ]
}
{% endschema %}
