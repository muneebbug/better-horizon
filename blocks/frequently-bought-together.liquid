{% doc %}
  Frequently Bought Together / Bundle Recommendations Block
  Renders the main product along with complementary items to encourage multi-item purchases.
{% enddoc %}

{%- liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign max_items = block.settings.products_to_show | default: 2

  assign bundle_products = product.metafields.custom.bundle_products.value
  if bundle_products == blank or bundle_products.size == 0
    if block.settings.products != blank
      assign bundle_products = block.settings.products
    else
      assign bundle_collection = product.collections.first | default: collections.all
      assign bundle_products = bundle_collection.products
    endif
  endif

  assign show_currency = settings.currency_code_enabled_product_pages
  if show_currency
    assign money_format = shop.money_with_currency_format
  else
    assign money_format = shop.money_format
  endif

  assign main_variant = product.selected_or_first_available_variant
  assign bundle_total_cents = main_variant.price | default: 0
-%}

<script
  src="{{ 'bundle-recommendations.js' | asset_url }}"
  defer
  type="module"
></script>

<div
  class="bundle-block bundle-block--{{ block.id }}"
  {{ block.shopify_attributes }}
>
  <bundle-recommendations
    class="bundle-recommendations"
    data-product-id="{{ product.id }}"
    data-section-id="{{ section.id }}"
    data-money-format="{{ money_format | escape }}"
    data-currency="{{ cart.currency.iso_code }}"
    data-button-text="{{ block.settings.button_label | default: 'Add Bundle to Cart' }}"
  >
    <h3 class="bundle-block__title">{{ block.settings.heading }}</h3>

    <div class="bundle-block__grid" data-bundle-items>
      {%- comment -%} Main Product Item {%- endcomment -%}
      <div class="bundle-item">
        <label class="bundle-item__checkbox-label">
          <input
            type="checkbox"
            checked
            disabled
            data-variant-id="{{ main_variant.id }}"
            data-price-cents="{{ main_variant.price }}"
            class="bundle-item__checkbox"
            aria-label="{{ product.title | escape }}"
          >
          <span class="bundle-item__badge">This item:</span>
        </label>
        {%- if product.featured_image -%}
          <img
            src="{{ product.featured_image | image_url: width: 140 }}"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            class="bundle-item__image"
            width="70"
            height="70"
            loading="lazy"
          >
        {%- endif -%}
        <div class="bundle-item__info">
          <span class="bundle-item__title">{{ product.title }}</span>
          <span class="bundle-item__price">{{ main_variant.price | money }}</span>
        </div>
      </div>

      {%- comment -%} Complementary Items {%- endcomment -%}
      {%- assign rendered_count = 0 -%}
      {%- if bundle_products != blank -%}
        {%- for rec_product in bundle_products -%}
          {%- if rendered_count >= max_items -%}
            {%- break -%}
          {%- endif -%}
          {%- if rec_product.id != product.id -%}
            {%- assign rec_variant = rec_product.selected_or_first_available_variant -%}
            {%- if rec_variant and rec_variant.available -%}
              {%- assign rendered_count = rendered_count | plus: 1 -%}
              {%- assign bundle_total_cents = bundle_total_cents | plus: rec_variant.price -%}
              <div class="bundle-item">
                <label class="bundle-item__checkbox-label">
                  <input
                    type="checkbox"
                    checked
                    data-variant-id="{{ rec_variant.id }}"
                    data-price-cents="{{ rec_variant.price }}"
                    class="bundle-item__checkbox"
                    aria-label="{{ rec_product.title | escape }}"
                  >
                </label>
                {%- if rec_product.featured_image -%}
                  <img
                    src="{{ rec_product.featured_image | image_url: width: 140 }}"
                    alt="{{ rec_product.featured_image.alt | default: rec_product.title | escape }}"
                    class="bundle-item__image"
                    width="70"
                    height="70"
                    loading="lazy"
                  >
                {%- endif -%}
                <div class="bundle-item__info">
                  <a href="{{ rec_product.url }}" class="bundle-item__title">{{ rec_product.title }}</a>
                  <span class="bundle-item__price">{{ rec_variant.price | money }}</span>
                </div>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if rendered_count == 0 and request.design_mode -%}
        <p class="bundle-item__empty-note">
          No complementary items found. Choose fallback products below or configure the custom.bundle_products metafield.
        </p>
      {%- endif -%}
    </div>

    <div class="bundle-block__footer">
      <div class="bundle-block__total">
        <span>Total Price:</span>
        <strong data-bundle-total class="bundle-block__total-price">{{ bundle_total_cents | money }}</strong>
      </div>
      <button
        type="button"
        class="button bundle-block__button"
        data-bundle-add-button
      >
        {{ block.settings.button_label | default: 'Add Bundle to Cart' }}
      </button>
    </div>
  </bundle-recommendations>
</div>

{% stylesheet %}
  .bundle-block {
    margin: 0;
    padding: var(--padding-lg, 20px);
    border: var(--style-border-width, 1px) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25, 0.15));
    border-radius: var(--style-border-radius-inputs, 8px);
    background-color: rgb(var(--color-foreground-rgb) / 0.03);
    color: var(--color-foreground);
  }

  .bundle-block__title {
    margin: 0 0 var(--margin-md, 16px) 0;
    font-size: var(--font-body--size, 15px);
    font-weight: 600;
    color: var(--color-foreground);
  }

  .bundle-block__grid {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md, 12px);
    margin-bottom: var(--margin-md, 16px);
  }

  .bundle-item {
    display: flex;
    align-items: center;
    gap: var(--gap-sm, 12px);
  }

  .bundle-item__checkbox-label {
    display: flex;
    align-items: center;
    cursor: pointer;
  }

  .bundle-item__checkbox {
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: var(--color-foreground);
  }

  .bundle-item__badge {
    font-size: 0.8em;
    font-weight: 600;
    margin-left: 4px;
    color: var(--color-foreground);
  }

  .bundle-item__image {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: var(--style-border-radius-inputs, 6px);
  }

  .bundle-item__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .bundle-item__title {
    font-size: var(--font-body--size, 14px);
    font-weight: 500;
    text-decoration: none;
    color: var(--color-foreground);
  }

  .bundle-item__title:hover {
    text-decoration: underline;
  }

  .bundle-item__price {
    font-size: var(--font-body--size, 13px);
    color: var(--color-foreground-subdued, rgb(var(--color-foreground-rgb) / 0.7));
  }

  .bundle-item__empty-note {
    font-size: var(--font-body--size, 13px);
    color: var(--color-foreground-subdued, rgb(var(--color-foreground-rgb) / 0.7));
    margin: 0;
    font-style: italic;
  }

  .bundle-block__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--padding-md, 14px);
    border-top: var(--style-border-width, 1px) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25, 0.15));
    flex-wrap: wrap;
    gap: var(--gap-sm, 8px);
  }

  .bundle-block__total {
    font-size: var(--font-body--size, 14px);
    display: flex;
    gap: 6px;
    align-items: baseline;
    color: var(--color-foreground);
  }

  .bundle-block__total-price {
    font-size: 1.1em;
    font-weight: 600;
  }

  .bundle-block__button {
    min-height: var(--height-buy-buttons, 44px);
    padding: 0 var(--padding-xl, 20px);
    border-radius: var(--style-border-radius-buttons-primary, 9999px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Frequently bought",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Display complementary products in a bundle with real-time price updates and one-click add to cart."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Bought Together"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add Bundle to Cart"
    },
    {
      "type": "header",
      "content": "Product recommendations"
    },
    {
      "type": "paragraph",
      "content": "Products are loaded dynamically using the following priority:\n1. Curated Metafield: 'custom.bundle_products' (List of Products) on the product.\n2. Fallback Products: Selected below when no product metafield is set.\n3. Automatic Fallback: Related products from the current collection."
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Fallback products",
      "limit": 4,
      "info": "Choose default products to bundle when a product has no custom bundle metafield assigned."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Items to show",
      "default": 2
    }
  ],
  "presets": [
    {
      "name": "Frequently bought together"
    }
  ]
}
{% endschema %}

