{% doc %}
  Form Submit Button Block
  Renders the primary form submission trigger for custom forms.
{% enddoc %}

{% render 'form-submit-button-styles' %}

{%- liquid
  assign block_settings = block.settings
  assign label = block_settings.label | default: 'Send message'
  assign style_class = block_settings.style_class | default: 'button-primary'
  assign alignment = block_settings.alignment | default: 'left'
  assign width = block_settings.width | default: 'auto'
  assign button_size = block_settings.button_size | default: 'medium'

  assign is_custom = false
  if style_class == 'button-custom'
    assign is_custom = true
  endif
-%}

<div
  class="custom-form__submit-wrapper custom-form__submit-wrapper--{{ alignment }}{% if width == 'full_width' %} custom-form__submit-wrapper--full-width{% endif %} spacing-style"
  style="
    {% render 'spacing-style', settings: block_settings %}
    {% if is_custom %}
      {% if block_settings.button_background_color != blank %}--form-btn-bg: {{ block_settings.button_background_color }};{% endif %}
      {% if block_settings.button_text_color != blank %}--form-btn-text: {{ block_settings.button_text_color }};{% endif %}
      {% if block_settings.button_border_color != blank %}--form-btn-border: {{ block_settings.button_border_color }};{% endif %}
      --form-btn-border-width: {{ block_settings.button_border_width | default: 1 }}px;
      --form-btn-radius: {{ block_settings.button_border_radius | default: 6 }}px;
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  <button
    type="submit"
    class="button {% if is_custom %}custom-form__submit-button--custom{% else %}{{ style_class }}{% endif %} custom-form__submit-button custom-form__submit-button--{{ button_size }}{% if width == 'full_width' %} custom-form__submit-button--full-width{% endif %}"
  >
    {{- label -}}
  </button>
</div>

{% schema %}
{
  "name": "Submit button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "default": "Send message"
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "Button style",
      "options": [
        {
          "value": "button-primary",
          "label": "Primary"
        },
        {
          "value": "button-secondary",
          "label": "Secondary"
        },
        {
          "value": "button-outline",
          "label": "Outline"
        },
        {
          "value": "button-custom",
          "label": "Custom colors"
        }
      ],
      "default": "button-primary"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background color",
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button border color",
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Button border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 6,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button sizing",
      "options": [
        {
          "value": "small",
          "label": "Small (compact)"
        },
        {
          "value": "medium",
          "label": "Medium (default)"
        },
        {
          "value": "large",
          "label": "Large (spacious)"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Button width",
      "options": [
        {
          "value": "auto",
          "label": "Auto (fit content)"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Button alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Submit button",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
