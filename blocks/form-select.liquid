{% doc %}
  Form Select Dropdown Block
  Renders a dropdown selector with nested Option blocks for custom forms.
{% enddoc %}

{% render 'form-select-styles' %}

{%- liquid
  assign block_settings = block.settings
  assign field_id = 'FormField-Select-' | append: block.id
  assign raw_name = block_settings.name | default: 'Subject'
  assign name_type = block_settings.name_type | default: 'contact'

  case name_type
    when 'contact'
      if raw_name contains 'contact['
        assign field_name = raw_name
      else
        assign field_name = 'contact[' | append: raw_name | append: ']'
      endif
    when 'property'
      if raw_name contains 'properties['
        assign field_name = raw_name
      else
        assign field_name = 'properties[' | append: raw_name | append: ']'
      endif
    when 'attribute'
      if raw_name contains 'attributes['
        assign field_name = raw_name
      else
        assign field_name = 'attributes[' | append: raw_name | append: ']'
      endif
    when 'custom'
      assign field_name = raw_name
  endcase

  assign field_label = block_settings.label | default: 'Subject'
  assign field_width = block_settings.width | default: '100'
  assign help_id = 'FormField-Help-' | append: block.id
-%}

<div
  class="custom-form__field custom-form__field--width-{{ field_width }} spacing-style"
  style="
    {% render 'spacing-style', settings: block_settings %}
    {% if block_settings.override_colors %}
      {% if block_settings.input_background_color != blank %}--color-input-background: {{ block_settings.input_background_color }};{% endif %}
      {% if block_settings.input_text_color != blank %}--color-input-text: {{ block_settings.input_text_color }};{% endif %}
      {% if block_settings.input_border_color != blank %}--color-input-border: {{ block_settings.input_border_color }};{% endif %}
      {% if block_settings.input_border_radius != blank %}--style-border-radius-inputs: {{ block_settings.input_border_radius }}px;{% endif %}
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  <label
    for="{{ field_id }}"
    class="custom-form__label{% if block_settings.hide_label %} visually-hidden{% endif %}"
  >
    {{- field_label -}}
    {%- if block_settings.required -%}
      <span class="custom-form__required-mark" aria-hidden="true">*</span>
    {%- endif -%}
  </label>

  <div class="custom-form__select-wrapper">
    <select
      id="{{ field_id }}"
      name="{{ field_name }}"
      class="custom-form__select"
      {% if block_settings.required %}
        required
        aria-required="true"
      {% endif %}
      {% if block_settings.help_text != blank %}
        aria-describedby="{{ help_id }}"
      {% endif %}
    >
      {%- if block_settings.placeholder != blank -%}
        <option value="" disabled selected hidden>
          {{- block_settings.placeholder | escape -}}
        </option>
      {%- endif -%}
      {% content_for 'blocks' %}
    </select>

    <svg
      aria-hidden="true"
      focusable="false"
      class="icon icon-caret"
      viewBox="0 0 10 6"
      width="10"
      height="6"
    >
      {%- render 'icon', icon: 'caret' -%}
    </svg>
  </div>

  {%- if block_settings.help_text != blank -%}
    <span id="{{ help_id }}" class="custom-form__help-text">
      {{- block_settings.help_text -}}
    </span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Select menu",
  "tag": null,
  "blocks": [
    {
      "type": "_form-select-option"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "name_type",
      "label": "Field purpose",
      "options": [
        {
          "value": "contact",
          "label": "Contact form (contact[...])"
        },
        {
          "value": "property",
          "label": "Line item property (properties[...])"
        },
        {
          "value": "attribute",
          "label": "Cart attribute (attributes[...])"
        },
        {
          "value": "custom",
          "label": "Custom (no wrapper)"
        }
      ],
      "default": "contact",
      "info": "Contact: for contact/inquiry forms. Line item property: for custom product options (color, material). Cart attribute: for cart-level order dropdowns. Custom: exact HTML name."
    },
    {
      "type": "text",
      "id": "name",
      "label": "Field name",
      "default": "Subject",
      "info": "Field key (e.g. Subject, Department, or Delivery Option). Brackets are added automatically based on purpose."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Subject"
    },
    {
      "type": "checkbox",
      "id": "hide_label",
      "label": "Visually hide label",
      "default": false
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder option",
      "default": "Select an option..."
    },
    {
      "type": "checkbox",
      "id": "required",
      "label": "Required field",
      "default": false
    },
    {
      "type": "select",
      "id": "width",
      "label": "Field width",
      "options": [
        {
          "value": "100",
          "label": "Full width (100%)"
        },
        {
          "value": "75",
          "label": "Three quarters (75%)"
        },
        {
          "value": "50",
          "label": "Half width (50%)"
        },
        {
          "value": "33",
          "label": "One third (33%)"
        },
        {
          "value": "25",
          "label": "One quarter (25%)"
        },
        {
          "value": "auto",
          "label": "Auto"
        }
      ],
      "default": "100"
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Helper text"
    },
    {
      "type": "header",
      "content": "Custom Styling Override"
    },
    {
      "type": "checkbox",
      "id": "override_colors",
      "label": "Override container styles for this field",
      "default": false
    },
    {
      "type": "color",
      "id": "input_background_color",
      "label": "Background color",
      "visible_if": "{{ block.settings.override_colors }}"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Text color",
      "visible_if": "{{ block.settings.override_colors }}"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Border color",
      "visible_if": "{{ block.settings.override_colors }}"
    },
    {
      "type": "range",
      "id": "input_border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 6,
      "visible_if": "{{ block.settings.override_colors }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Select menu",
      "category": "t:categories.forms",
      "blocks": {
        "option_1": {
          "type": "_form-select-option",
          "settings": {
            "label": "General inquiry",
            "value": "General inquiry"
          }
        },
        "option_2": {
          "type": "_form-select-option",
          "settings": {
            "label": "Order support",
            "value": "Order support"
          }
        },
        "option_3": {
          "type": "_form-select-option",
          "settings": {
            "label": "Wholesale & B2B",
            "value": "Wholesale & B2B"
          }
        }
      },
      "block_order": ["option_1", "option_2", "option_3"]
    }
  ]
}
{% endschema %}
