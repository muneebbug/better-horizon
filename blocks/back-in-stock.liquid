{% doc %}
  Back in Stock Notification Block
  Displays an email capture form when the current product variant is out of stock.
{% enddoc %}

{%- liquid
  assign block_settings = block.settings
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign selected_variant = product.selected_or_first_available_variant
  assign is_sold_out = false
  if selected_variant and selected_variant.available == false
    assign is_sold_out = true
  elsif product and product.available == false
    assign is_sold_out = true
  endif

  assign card_style = block_settings.card_style | default: 'default'
  assign layout = block_settings.layout | default: 'inline'
  assign button_style = block_settings.button_style | default: 'primary'
-%}

{%- style -%}
  .back-in-stock-block--{{ block.id }} {
    {% if card_style == 'custom' %}
      {% if block_settings.background_color != blank %}
        --bis-bg: {{ block_settings.background_color }};
      {% endif %}
      {% if block_settings.border_color != blank %}
        --bis-border: {{ block_settings.border_color }};
      {% endif %}
      {% if block_settings.border_width != blank %}
        --bis-border-width: {{ block_settings.border_width }}px;
      {% endif %}
      {% if block_settings.border_radius != blank %}
        --bis-border-radius: {{ block_settings.border_radius }}px;
      {% endif %}
    {% elsif card_style == 'minimal' %}
      --bis-bg: transparent;
      --bis-border: transparent;
      --bis-border-width: 0px;
    {% elsif card_style == 'outline' %}
      --bis-bg: transparent;
    {% endif %}

    {% if block_settings.heading_color != blank %}
      --bis-heading-color: {{ block_settings.heading_color }};
    {% endif %}
    {% if block_settings.subheading_color != blank %}
      --bis-subheading-color: {{ block_settings.subheading_color }};
    {% endif %}
    {% if block_settings.success_color != blank %}
      --bis-success-color: {{ block_settings.success_color }};
    {% endif %}

    {% if block_settings.input_background_color != blank %}
      --bis-input-bg: {{ block_settings.input_background_color }};
    {% endif %}
    {% if block_settings.input_text_color != blank %}
      --bis-input-text: {{ block_settings.input_text_color }};
    {% endif %}
    {% if block_settings.input_border_color != blank %}
      --bis-input-border: {{ block_settings.input_border_color }};
    {% endif %}
    {% if block_settings.input_border_radius != blank %}
      --bis-input-radius: {{ block_settings.input_border_radius }}px;
    {% endif %}
  }

  {% if button_style == 'custom' %}
    .back-in-stock-block--{{ block.id }} .back-in-stock__button {
      {% if block_settings.button_background_color != blank %}
        background-color: {{ block_settings.button_background_color }};
      {% endif %}
      {% if block_settings.button_text_color != blank %}
        color: {{ block_settings.button_text_color }};
      {% endif %}
      {% if block_settings.button_border_color != blank %}
        border-color: {{ block_settings.button_border_color }};
      {% endif %}
      {% if block_settings.button_border_radius != blank %}
        border-radius: {{ block_settings.button_border_radius }}px;
      {% endif %}
    }
  {% endif %}
{%- endstyle -%}

<script
  src="{{ 'back-in-stock.js' | asset_url }}"
  defer
  type="module"
></script>

<back-in-stock
  id="BackInStock--{{ block.id }}"
  class="back-in-stock-block back-in-stock-block--{{ block.id }} spacing-style"
  style="{% render 'spacing-style', settings: block_settings %}"
  data-block-id="{{ block.id }}"
  data-product-id="{{ product.id }}"
  data-product-title="{{ product.title | escape }}"
  data-product-handle="{{ product.handle }}"
  data-variant-id="{{ selected_variant.id }}"
  data-variant-title="{% if selected_variant.title != blank and selected_variant.title != 'Default Title' %}{{ selected_variant.title | escape }}{% endif %}"
  data-variant-sku="{{ selected_variant.sku | default: 'N/A' }}"
  data-shop-url="{{ shop.url }}"
  {% unless is_sold_out or request.design_mode %}
    hidden
  {% endunless %}
  {{ block.shopify_attributes }}
>
  <div class="back-in-stock-form-wrapper">
    <div class="back-in-stock__header">
      {%- if block_settings.heading != blank -%}
        <h3 class="back-in-stock__title">{{ block_settings.heading }}</h3>
      {%- endif -%}
      {%- if block_settings.subheading != blank -%}
        <p class="back-in-stock__subheading">{{ block_settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- liquid
      assign variant_title_clean = ''
      if selected_variant.title != blank and selected_variant.title != 'Default Title'
        assign variant_title_clean = selected_variant.title
      endif

      if variant_title_clean != blank
        assign full_product_title = product.title | append: ' - ' | append: variant_title_clean
      else
        assign full_product_title = product.title
      endif

      assign variant_url = shop.url | append: selected_variant.url
    -%}

    {%- form 'contact', id: 'BackInStockForm', class: 'back-in-stock__form' -%}
      <input
        type="hidden"
        name="contact[Product]"
        value="{{ full_product_title | escape }}"
      >
      <input
        type="hidden"
        name="contact[Variant Link]"
        value="{{ variant_url }}"
      >
      <input
        type="hidden"
        name="contact[SKU]"
        value="{{ selected_variant.sku | default: 'N/A' }}"
      >

      <div class="back-in-stock__input-group back-in-stock__input-group--{{ layout }}">
        <label for="BackInStockEmail--{{ block.id }}" class="visually-hidden">
          {{ block_settings.email_placeholder }}
        </label>
        <input
          id="BackInStockEmail--{{ block.id }}"
          type="email"
          name="contact[email]"
          class="back-in-stock__input"
          placeholder="{{ block_settings.email_placeholder }}"
          required
          aria-required="true"
        >
        <button
          type="submit"
          class="button back-in-stock__button button--{{ button_style }}"
        >
          {{ block_settings.button_label }}
        </button>
      </div>
    {%- endform -%}

    <div
      data-status-message
      class="back-in-stock__success"
      hidden
      tabindex="-1"
      aria-live="polite"
    >
      <span class="svg-wrapper back-in-stock__success-icon">
        {{ 'icon-checkmark.svg' | inline_asset_content }}
      </span>
      <p>{{ block_settings.success_message }}</p>
    </div>
  </div>
</back-in-stock>

{% stylesheet %}
  .back-in-stock-block {
    display: block;
    margin: 0;
    padding: var(--padding-lg, 20px);
    background-color: var(--bis-bg, rgb(var(--color-foreground-rgb) / 0.03));
    border: var(--bis-border-width, 1px) solid var(--bis-border, rgb(var(--color-foreground-rgb) / 0.15));
    border-radius: var(--bis-border-radius, var(--style-border-radius-inputs, 8px));
    box-sizing: border-box;
    width: 100%;
  }

  .back-in-stock-block[hidden],
  .back-in-stock-block.is-hidden {
    display: none !important;
  }

  .back-in-stock__header {
    margin-bottom: var(--margin-md, 14px);
  }

  .back-in-stock__title {
    margin: 0 0 4px 0;
    font-size: var(--font-body--size, 15px);
    font-weight: 600;
    line-height: 1.3;
    color: var(--bis-heading-color, var(--color-foreground));
  }

  .back-in-stock__subheading {
    margin: 0;
    font-size: var(--font-size--xs, 13px);
    color: var(--bis-subheading-color, var(--color-foreground-subdued, rgb(var(--color-foreground-rgb) / 0.7)));
    line-height: 1.4;
  }

  .back-in-stock__form {
    margin: 0;
  }

  .back-in-stock__input-group {
    display: flex;
    align-items: stretch;
    gap: var(--gap-xs, 8px);
    width: 100%;
  }

  .back-in-stock__input-group--stacked {
    flex-direction: column;
  }

  .back-in-stock__input {
    flex: 1;
    min-width: 0;
    height: 44px;
    padding: 0 var(--padding-md, 14px);
    background-color: var(--bis-input-bg, var(--color-input-background, var(--color-background)));
    color: var(--bis-input-text, var(--color-input-text, var(--color-foreground)));
    border: var(--style-border-width, 1px) solid
      var(--bis-input-border, var(--color-input-border, rgb(var(--color-foreground-rgb) / 0.15)));
    border-radius: var(--bis-input-radius, var(--style-border-radius-inputs, 8px));
    font-family: inherit;
    font-size: var(--font-body--size, 14px);
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .back-in-stock__input:focus-visible {
    outline: none;
    border-color: var(--color-foreground);
    box-shadow: 0 0 0 1px var(--color-foreground);
  }

  .back-in-stock__button {
    height: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--padding-xl, 20px);
    border-radius: var(--style-border-radius-buttons-primary, 8px);
    font-family: var(--button-font-family-primary, inherit);
    font-size: var(--font-body--size, 14px);
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
    box-sizing: border-box;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .back-in-stock__button:hover {
    opacity: 0.9;
  }

  .back-in-stock__input-group--stacked .back-in-stock__button {
    width: 100%;
  }

  .back-in-stock__success {
    display: flex;
    align-items: center;
    gap: var(--gap-xs, 8px);
    color: var(--bis-success-color, #16a34a);
    font-size: var(--font-body--size, 14px);
    font-weight: 500;
    margin-top: var(--margin-md, 14px);
    line-height: 1.4;
  }

  .back-in-stock__success[hidden] {
    display: none !important;
  }

  .back-in-stock__success p {
    margin: 0;
  }

  .back-in-stock__success-icon {
    width: 18px;
    height: 18px;
    color: var(--bis-success-color, #16a34a);
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 480px) {
    .back-in-stock__input {
      flex: auto;
    }
    .back-in-stock__input-group {
      flex-direction: column;
    }

    .back-in-stock__button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Back in stock capture",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Displays an email notification capture form when the current product or variant is sold out."
    },
    {
      "type": "header",
      "content": "Content & Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Notify me when available"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "We will email you as soon as this item is restocked."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Notify Me"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you! We will notify you when restocked."
    },
    {
      "type": "header",
      "content": "Form Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Form layout",
      "options": [
        {
          "value": "inline",
          "label": "Inline (input & button side-by-side)"
        },
        {
          "value": "stacked",
          "label": "Stacked (full-width button below)"
        }
      ],
      "default": "inline"
    },
    {
      "type": "header",
      "content": "Card Style & Colors"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Container style",
      "options": [
        {
          "value": "default",
          "label": "Default card"
        },
        {
          "value": "minimal",
          "label": "Minimal (borderless / transparent)"
        },
        {
          "value": "outline",
          "label": "Outline only"
        },
        {
          "value": "custom",
          "label": "Custom colors"
        }
      ],
      "default": "default"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Container background color",
      "visible_if": "{{ block.settings.card_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Container border color",
      "visible_if": "{{ block.settings.card_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Container border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.card_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Container corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ block.settings.card_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color"
    },
    {
      "type": "color",
      "id": "success_color",
      "label": "Success message & icon color"
    },
    {
      "type": "header",
      "content": "Input Field Styling"
    },
    {
      "type": "color",
      "id": "input_background_color",
      "label": "Input background color"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Input text color"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Input border color"
    },
    {
      "type": "range",
      "id": "input_border_radius",
      "label": "Input corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Button Styling"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style preset",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "primary"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Custom button background",
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Custom button text color",
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Custom button border color",
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Back in stock capture",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
