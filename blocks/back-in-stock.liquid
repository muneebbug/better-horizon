{% doc %}
  Back in Stock Notification Block
  Displays an email capture form when the current product variant is out of stock.
{% enddoc %}

{%- liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign selected_variant = product.selected_or_first_available_variant
  assign is_sold_out = false
  if selected_variant and selected_variant.available == false
    assign is_sold_out = true
  elsif product and product.available == false
    assign is_sold_out = true
  endif
-%}

<script
  src="{{ 'back-in-stock.js' | asset_url }}"
  defer
  type="module"
></script>

<div
  class="back-in-stock-block back-in-stock-block--{{ block.id }}{% unless is_sold_out or request.design_mode %} is-hidden{% endunless %}"
  {{ block.shopify_attributes }}
>
  <back-in-stock-form class="back-in-stock-form-wrapper">
    <div class="back-in-stock__header">
      <h3 class="back-in-stock__title">{{ block.settings.heading }}</h3>
      {%- if block.settings.subheading != blank -%}
        <p class="back-in-stock__subheading">{{ block.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- form 'contact', id: 'BackInStockForm', class: 'back-in-stock__form' -%}
      <input
        type="hidden"
        name="contact[tags]"
        value="back-in-stock-request"
      >
      <input
        type="hidden"
        name="contact[body]"
        value="Customer requested notification when '{{ product.title | escape }}' (SKU: {{ selected_variant.sku | default: 'N/A' }}) is back in stock."
      >

      <div class="back-in-stock__input-group">
        <label for="BackInStockEmail--{{ block.id }}" class="visually-hidden">
          {{ block.settings.email_placeholder }}
        </label>
        <input
          id="BackInStockEmail--{{ block.id }}"
          type="email"
          name="contact[email]"
          class="back-in-stock__input"
          placeholder="{{ block.settings.email_placeholder }}"
          required
          aria-required="true"
        >
        <button
          type="submit"
          class="button back-in-stock__button"
        >
          {{ block.settings.button_label }}
        </button>
      </div>
    {%- endform -%}

    <div
      data-status-message
      class="back-in-stock__success"
      hidden
      tabindex="-1"
      aria-live="polite"
    >
      <span class="svg-wrapper back-in-stock__success-icon">
        {{ 'icon-checkmark.svg' | inline_asset_content }}
      </span>
      <p>{{ block.settings.success_message }}</p>
    </div>
  </back-in-stock-form>
</div>

{% stylesheet %}
  .back-in-stock-block {
    margin: 0;
    padding: var(--padding-lg, 20px);
    background-color: rgb(var(--color-foreground-rgb) / 0.03);
    border: var(--style-border-width, 1px) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25, 0.15));
    border-radius: var(--style-border-radius-inputs, 8px);
    box-sizing: border-box;
    width: 100%;
  }

  .back-in-stock-block.is-hidden {
    display: none;
  }

  .back-in-stock__header {
    margin-bottom: var(--margin-md, 14px);
  }

  .back-in-stock__title {
    margin: 0 0 4px 0;
    font-size: var(--font-body--size, 15px);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-foreground);
  }

  .back-in-stock__subheading {
    margin: 0;
    font-size: var(--font-size--xs, 13px);
    color: var(--color-foreground-subdued, rgb(var(--color-foreground-rgb) / 0.7));
    line-height: 1.4;
  }

  .back-in-stock__form {
    margin: 0;
  }

  .back-in-stock__input-group {
    display: flex;
    align-items: stretch;
    gap: var(--gap-xs, 8px);
    width: 100%;
  }

  .back-in-stock__input {
    flex: 1;
    min-width: 0;
    height: 44px;
    padding: 0 var(--padding-md, 14px);
    background-color: var(--color-input-background, var(--color-background));
    color: var(--color-input-text, var(--color-foreground));
    border: var(--style-border-width, 1px) solid var(--color-input-border, rgb(var(--color-foreground-rgb) / var(--opacity-10-25, 0.15)));
    border-radius: var(--style-border-radius-inputs, 8px);
    font-family: inherit;
    font-size: var(--font-body--size, 14px);
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .back-in-stock__input:focus-visible {
    outline: none;
    border-color: var(--color-foreground);
    box-shadow: 0 0 0 1px var(--color-foreground);
  }

  .back-in-stock__button {
    height: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--padding-xl, 20px);
    border-radius: var(--style-border-radius-buttons-primary, 8px);
    font-family: var(--button-font-family-primary, inherit);
    font-size: var(--font-body--size, 14px);
    font-weight: 500;
    white-space: nowrap;
    flex-shrink: 0;
    box-sizing: border-box;
    cursor: pointer;
  }

  .back-in-stock__success {
    display: flex;
    align-items: center;
    gap: var(--gap-xs, 8px);
    color: #16a34a;
    font-size: var(--font-body--size, 14px);
    font-weight: 500;
    margin-top: var(--margin-md, 14px);
    line-height: 1.4;
  }

  .back-in-stock__success p {
    margin: 0;
  }

  .back-in-stock__success-icon {
    width: 18px;
    height: 18px;
    color: #16a34a;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 480px) {
    .back-in-stock__input-group {
      flex-direction: column;
    }

    .back-in-stock__button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Back in stock capture",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Notify me when available"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "We will email you as soon as this item is restocked."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Notify Me"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you! We will notify you when restocked."
    }
  ],
  "presets": [
    {
      "name": "Back in stock capture"
    }
  ]
}
{% endschema %}
