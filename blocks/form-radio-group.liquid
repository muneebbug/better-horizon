{% doc %}
  Form Radio Group Block
  Renders an accessible set of radio button options under a fieldset and legend.
{% enddoc %}

{% render 'form-radio-styles' %}

{%- liquid
  assign block_settings = block.settings
  assign raw_name = block_settings.name | default: 'inquiry_type'
  assign name_type = block_settings.name_type | default: 'contact'

  case name_type
    when 'contact'
      if raw_name contains 'contact['
        assign field_name = raw_name
      else
        assign field_name = 'contact[' | append: raw_name | append: ']'
      endif
    when 'property'
      if raw_name contains 'properties['
        assign field_name = raw_name
      else
        assign field_name = 'properties[' | append: raw_name | append: ']'
      endif
    when 'attribute'
      if raw_name contains 'attributes['
        assign field_name = raw_name
      else
        assign field_name = 'attributes[' | append: raw_name | append: ']'
      endif
    when 'custom'
      assign field_name = raw_name
  endcase

  assign field_label = block_settings.label | default: 'Inquiry type'
  assign field_width = block_settings.width | default: '100'
  assign layout = block_settings.layout | default: 'row'
  assign default_val = block_settings.default_option
  assign help_id = 'FormField-Help-' | append: block.id

  assign raw_options = block_settings.options | default: "General inquiry\nOrder support\nOther"
  assign options_array = raw_options | newline_to_br | split: '<br />'
-%}

<div
  class="custom-form__field custom-form__field--width-{{ field_width }} spacing-style"
  style="
    {% render 'spacing-style', settings: block_settings %}
    {% if block_settings.override_colors %}
      {% if block_settings.active_background_color != blank %}--form-radio-active-bg: {{ block_settings.active_background_color }};{% endif %}
      {% if block_settings.active_text_color != blank %}--form-radio-active-text: {{ block_settings.active_text_color }};{% endif %}
      {% if block_settings.active_border_color != blank %}--form-radio-active-border: {{ block_settings.active_border_color }};{% endif %}
      {% if block_settings.border_radius != blank %}--style-border-radius-inputs: {{ block_settings.border_radius }}px;{% endif %}
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  <fieldset
    class="custom-form__radio-group"
    {% if block_settings.help_text != blank %}
      aria-describedby="{{ help_id }}"
    {% endif %}
  >
    <legend class="custom-form__radio-legend">
      {{- field_label -}}
      {%- if block_settings.required -%}
        <span class="custom-form__required-mark" aria-hidden="true">*</span>
      {%- endif -%}
    </legend>

    <div class="custom-form__radio-options custom-form__radio-options--{{ layout }}">
      {%- for option in options_array -%}
        {%- assign opt_clean = option | strip -%}
        {%- if opt_clean != blank -%}
          {%- assign opt_id = 'FormField-Radio-' | append: block.id | append: '-' | append: forloop.index -%}
          <label for="{{ opt_id }}" class="custom-form__radio-label">
            <input
              type="radio"
              id="{{ opt_id }}"
              name="{{ field_name }}"
              value="{{ opt_clean | escape }}"
              {% if opt_clean == default_val or forloop.first and default_val == blank %}
                checked
              {% endif %}
              {% if block_settings.required %}
                required
                aria-required="true"
              {% endif %}
            >
            <span>{{ opt_clean }}</span>
          </label>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </fieldset>

  {%- if block_settings.help_text != blank -%}
    <span id="{{ help_id }}" class="custom-form__help-text">
      {{- block_settings.help_text -}}
    </span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Radio group",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "name_type",
      "label": "Field purpose",
      "options": [
        {
          "value": "contact",
          "label": "Contact form (contact[...])"
        },
        {
          "value": "property",
          "label": "Line item property (properties[...])"
        },
        {
          "value": "attribute",
          "label": "Cart attribute (attributes[...])"
        },
        {
          "value": "custom",
          "label": "Custom (no wrapper)"
        }
      ],
      "default": "contact",
      "info": "Contact: for contact/inquiry forms. Line item property: for custom product options (styles, choices). Cart attribute: for cart-level order radio options. Custom: exact HTML name."
    },
    {
      "type": "text",
      "id": "name",
      "label": "Field name",
      "default": "inquiry_type",
      "info": "Field key (e.g. inquiry_type, Packaging, or shipping_preference). Brackets are added automatically based on purpose."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Group label (Legend)",
      "default": "Inquiry type"
    },
    {
      "type": "textarea",
      "id": "options",
      "label": "Options (one per line)",
      "default": "General inquiry\nOrder support\nOther"
    },
    {
      "type": "text",
      "id": "default_option",
      "label": "Default selected option"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Options layout",
      "options": [
        {
          "value": "row",
          "label": "Horizontal (inline wrap)"
        },
        {
          "value": "column",
          "label": "Vertical (stacked)"
        },
        {
          "value": "grid-2",
          "label": "2 Columns Grid"
        },
        {
          "value": "grid-3",
          "label": "3 Columns Grid"
        }
      ],
      "default": "row"
    },
    {
      "type": "checkbox",
      "id": "required",
      "label": "Required selection",
      "default": false
    },
    {
      "type": "select",
      "id": "width",
      "label": "Field width",
      "options": [
        {
          "value": "100",
          "label": "Full width (100%)"
        },
        {
          "value": "75",
          "label": "Three quarters (75%)"
        },
        {
          "value": "50",
          "label": "Half width (50%)"
        },
        {
          "value": "auto",
          "label": "Auto"
        }
      ],
      "default": "100"
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Helper text"
    },
    {
      "type": "header",
      "content": "Custom Styling Override"
    },
    {
      "type": "checkbox",
      "id": "override_colors",
      "label": "Override colors for radio buttons",
      "default": false
    },
    {
      "type": "color",
      "id": "active_background_color",
      "label": "Active background color",
      "visible_if": "{{ block.settings.override_colors }}"
    },
    {
      "type": "color",
      "id": "active_text_color",
      "label": "Active text color",
      "visible_if": "{{ block.settings.override_colors }}"
    },
    {
      "type": "color",
      "id": "active_border_color",
      "label": "Active border color",
      "visible_if": "{{ block.settings.override_colors }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 6,
      "visible_if": "{{ block.settings.override_colors }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Radio group",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
